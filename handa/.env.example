# HANDA (prepare.ph) — environment
# Copy to `.env.local` (git-ignored by Vite) and fill in. Every variable is
# optional: with the Supabase ones missing the app runs fully in guest mode
# (local-only, no accounts, no sync) and never touches the network.
#
# Only variables prefixed VITE_ are exposed to the browser bundle. The anon key
# is designed to be public; security comes from Row Level Security (see
# supabase/schema.sql). NEVER put the service_role key or the DB password here.

# Supabase project URL — Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=

# Supabase anon (public) key — Dashboard > Project Settings > API > anon public
VITE_SUPABASE_ANON_KEY=

# Show the "Continue with Google" button. Set to 1 only after enabling the
# Google provider in Supabase (Authentication > Providers > Google).
VITE_GOOGLE_AUTH=0

# Canonical site URL (no trailing slash). Used for share links / OG tags and as
# the auth redirect base when `window` is unavailable. Must match the Site URL
# configured in Supabase Authentication > URL Configuration, with
# `<VITE_SITE_URL>/auth/callback` in the Redirect URLs list.
VITE_SITE_URL=http://localhost:5173
