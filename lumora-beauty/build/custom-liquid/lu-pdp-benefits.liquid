{%- comment -%}
  LUMORA PDP BENEFITS  ·  lu-pdp-benefits.liquid
  Paste into: Product information > Add block > Custom Liquid, directly BELOW the lexicon line.
  Three icon rows from custom.benefit_1 to custom.benefit_3, each "icon|text" (icons: even, absorb, amber,
  drop, tones, vegan, ship, guarantee, check). A superscript 2 in the text becomes a sun-dot marker, and the
  one-line method sits directly beneath, as in the mockup.
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.custom
  assign lu_all = m.benefit_1.value | append: m.benefit_2.value | append: m.benefit_3.value
-%}
<ul class="lu-pdp-benefits">
{%- for n in (1..3) -%}
  {%- assign lu_key = 'benefit_' | append: n -%}
  {%- assign lu_raw = m[lu_key].value | default: '' -%}
  {%- if lu_raw != '' -%}
    {%- if lu_raw contains '|' -%}{%- assign lu_ic = lu_raw | split: '|' | first | strip -%}{%- assign lu_tx = lu_raw | split: '|' | last | strip -%}{%- else -%}{%- assign lu_ic = 'check' -%}{%- assign lu_tx = lu_raw -%}{%- endif -%}
    <li><svg class="lu-ico" aria-hidden="true"><use href="#lu-i-{{ lu_ic }}"/></svg><span>{{ lu_tx | replace: '²', '<sup class="lu-fn" data-fn="2">2</sup>' | replace: '¹', '<sup class="lu-fn" data-fn="1">1</sup>' }}</span></li>
  {%- endif -%}
{%- endfor -%}
</ul>
{%- if lu_all contains '²' -%}<p class="lu-pdp-fn lu-footnotes" data-fn-note="2"><sup class="lu-fn">2</sup>Consumer perception study, 32 people, 4 weeks. Illustrative placeholder data.</p>{%- endif -%}
