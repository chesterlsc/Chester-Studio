<style>
.lu-pdp-complete__grid{display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px; align-items: center;}
.lu-pdp-complete__scene{aspect-ratio: 3 / 2;}
.lu-pdp-pin-here{width: 40px; height: 40px; margin: -20px 0 0 -20px; background: var(--lu-terracotta); color: var(--lu-linen);}
.lu-pdp-complete__list{padding: 24px 28px 26px; border-radius: var(--lu-radius); background: var(--lu-linen); box-shadow: 0 1px 0 var(--lu-hairline);}
.lu-pdp-checklist li{display: grid; grid-template-columns: 22px 50px 1fr auto; align-items: center; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--lu-hairline);}
.lu-pdp-checklist li:first-child{padding-top: 0;}
.lu-pdp-check{display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--lu-dusk); color: var(--lu-linen);}
.lu-pdp-check .lu-ico{width: 14px; height: 14px; stroke-width: 2;}
.lu-pdp-checklist__no{display: flex; align-items: center; gap: 6px; font: 600 11px/1 var(--lu-body); letter-spacing: .12em; color: var(--lu-terracotta);}
.lu-pdp-checklist__no .lu-sunmark{width: 24px; height: 15px;}
.lu-pdp-checklist__name{font: 400 17px/1.2 var(--lu-display);}
.lu-pdp-checklist__name small{display: block; margin-top: 3px; font: 400 12.5px/1.3 var(--lu-body); color: rgb(var(--color-foreground-secondary));}
.lu-pdp-checklist li.is-here .lu-pdp-checklist__name small{font-weight: 600; color: var(--lu-terracotta);}
.lu-pdp-checklist b{font-size: 15px; font-weight: 600;}
.lu-pdp-complete__total{flex-wrap: wrap; gap: 6px 14px; margin-top: 18px;}
.lu-pdp-complete__total .lu-was{flex-basis: 100%;}
.lu-pdp-complete__btn{width: 100%; margin-top: 18px;}
.lu-pdp-complete__alt{margin-top: 16px; text-align: center;}
.lu-pdp-complete__list .lu-reassure{justify-content: center; margin-top: 16px;}
@media (max-width: 767px){
.lu-pdp-complete__grid{display: block;}
.lu-pdp-complete__scene{aspect-ratio: 4 / 5;}
.lu-pdp-complete__list{margin-top: 12px; padding: 20px 16px 22px;}
.lu-pdp-checklist li{grid-template-columns: 22px 40px 1fr auto; gap: 10px;}
.lu-pdp-checklist__no{flex-direction: column; align-items: flex-start; gap: 3px;}
.lu-pdp-checklist__name{font-size: 16px;}
.lu-pdp-complete__total strong{font-size: 32px;}
.lu-pdp-complete__list .lu-reassure{justify-content: flex-start;}
}
.lu-pdp-checklist{list-style:none;margin:0;padding:0}
.lu-pdp-complete__btn{display:flex}
.lu-pdp-pin-here{background:var(--lu-terracotta)!important;color:var(--lu-linen)!important}
</style>
