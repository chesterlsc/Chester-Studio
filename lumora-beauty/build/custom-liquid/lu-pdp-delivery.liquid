{%- comment -%}
  LUMORA PDP SHIPPING + DELIVERY LINES  ·  lu-pdp-delivery.liquid
  Paste into: Product information > Add block > Custom Liquid, directly BELOW Buy buttons.
  "Free US shipping over $65. Any second step gets you there." (it names the step that closes the gap when
  the travel size is selected) and "Order today, arrives Mon, Nov 30 – Wed, Dec 2": one working day to
  dispatch, then 3 to 5 working days, skipping weekends and US carrier holidays (the mockup's script).
  No countdown. Replaces Minimog's Shipping information block, which cannot skip holidays.
{%- endcomment -%}
{%- liquid
  assign lu_threshold = 6500
  assign lu_handles = 'sunmelt-cleansing-balm,long-light-serum,haze-soft-focus-cream,apricity-lip-cheek-balm,gloaming-body-oil,slow-hour-golden-milk' | split: ','
  assign lu_names = 'Sunmelt,Long Light,Haze,Apricity,Gloaming,Slow Hour' | split: ','
  assign lu_price = product.selected_or_first_available_variant.price
-%}
<ul class="lu-pdp-ship">
  <li><svg class="lu-ico" aria-hidden="true"><use href="#lu-i-ship"/></svg><span data-lu-free>Free US shipping over $65.{% if lu_price < lu_threshold %} Any second step gets you there.{% endif %}</span></li>
  <li><svg class="lu-ico" aria-hidden="true"><use href="#lu-i-cal"/></svg><span>Order today, arrives <strong data-lu-delivery>in 4 to 6 working days</strong></span></li>
</ul>
<script type="application/json" data-lu-ship-data>{"t":{{ lu_threshold }},"p":{{ lu_price }},"v":{{ product.variants | map: 'id' | json }},"o":[{%- assign lu_first = true -%}{%- for h in lu_handles -%}{%- assign op = all_products[h] -%}{%- if op.id and op.id != product.id -%}{%- unless lu_first -%},{%- endunless -%}{"n":{{ lu_names[forloop.index0] | json }},"p":{{ op.price }}}{%- assign lu_first = false -%}{%- endif -%}{%- endfor -%}],"hol":["2026-11-26","2026-12-25","2027-01-01","2027-01-18","2027-02-15","2027-05-31","2027-07-05","2027-09-06","2027-11-25","2027-12-24"]}</script>
<script>
(function(){
  "use strict";
  var box=document.querySelector("[data-lu-ship-data]");if(!box)return;var D={};try{D=JSON.parse(box.textContent)}catch(e){return}
  /* Free-shipping line: "Any second step gets you there" when the cheapest other step clears $65, else name the step that does */
  function usd(c){return"$"+(c%100?(c/100).toFixed(2):String(c/100))}
  function free(price){var el=document.querySelector("[data-lu-free]");if(!el)return;var gap=D.t-price;if(gap<=0){el.textContent="Free US shipping over $65: this ships free.";return}
    var others=(D.o||[]).slice().sort(function(a,b){return a.p-b.p});
    if(others.length&&others[0].p>=gap){el.textContent="Free US shipping over $65. Any second step gets you there.";return}
    var pick=others.filter(function(x){return x.p>=gap})[0];
    el.textContent="You’re "+usd(gap)+" from free US shipping."+(pick?" "+(/^[AEIOU]/.test(pick.n)?"An ":"A ")+pick.n+" would do it.":"")}
  /* Delivery estimate, as in the mockup: one working day to dispatch, then 3 to 5 working days, skipping weekends and US carrier holidays */
  function eta(){var el=document.querySelector("[data-lu-delivery]");if(!el)return;var hol=D.hol||[];
    function iso(d){return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")}
    function work(d){var w=d.getDay();return w!==0&&w!==6&&hol.indexOf(iso(d))===-1}
    function add(d,n){var r=new Date(d);while(n>0){r.setDate(r.getDate()+1);if(work(r))n--}return r}
    var fmt=new Intl.DateTimeFormat("en-US",{weekday:"short",month:"short",day:"numeric"}),ship=add(new Date(),1);
    el.textContent=fmt.format(add(ship,3))+" – "+fmt.format(add(ship,5))}
  free(D.p);try{eta()}catch(e){}
  document.addEventListener("variant:changed",function(e){var v=e.detail&&e.detail.variant;if(v&&(D.v||[]).indexOf(v.id)>-1)free(v.price)});
})();
</script>
