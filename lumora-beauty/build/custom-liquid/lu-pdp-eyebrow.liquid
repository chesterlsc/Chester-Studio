{%- comment -%}
  LUMORA PDP EYEBROW  ·  lu-pdp-eyebrow.liquid
  Paste into: Product information > Add block > Custom Liquid, directly ABOVE Title (below Breadcrumb).
  "Step 02 · Glow" with the step's sun mark, from custom.step ("02") and custom.ritual ("Glow").
  The PDP mockup export shows "Treat"; the build uses "Glow" to match the homepage ritual list and to keep
  "treats" off the page. Changing it back is one metafield.
{%- endcomment -%}
{%- assign lu_step = product.metafields.custom.step.value | default: '' -%}
{%- assign lu_ritual = product.metafields.custom.ritual.value | default: '' -%}
{%- if lu_step != '' -%}
{%- assign lu_n = lu_step | plus: 0 -%}{%- if lu_n < 1 or lu_n > 6 -%}{%- assign lu_n = 2 -%}{%- endif -%}
<p class="lu-eyebrow lu-pdp-eyebrow"><svg class="lu-sunmark" aria-hidden="true"><use href="#lu-m{{ lu_n }}"/></svg>Step {{ lu_step }}{% if lu_ritual != '' %} · {{ lu_ritual }}{% endif %}</p>
{%- endif -%}
