{%- comment -%}
  LUMORA PDP AT A GLANCE  ·  lu-pdp-glance.liquid
  Paste into: Product information > Add block > Custom Liquid, directly BELOW the benefits.
  Rows from custom.suited_to, custom.finish, custom.scent, custom.key_ingredients and custom.pairs_with (a
  product handle). On Long Light, "Pairs with" jumps to the golden pair card (#pair). Empty rows are skipped.
  On phones lu-pdp-skin moves this block below the trust row, as in the mockup.
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.custom
  assign lu_pair = all_products[m.pairs_with.value]
-%}
<dl class="lu-pdp-glance">
  {%- if m.suited_to.value != blank -%}<div><dt>Suited to</dt><dd>{{ m.suited_to.value }}</dd></div>{%- endif -%}
  {%- if m.finish.value != blank -%}<div><dt>Finish</dt><dd>{{ m.finish.value }}</dd></div>{%- endif -%}
  {%- if m.scent.value != blank -%}<div><dt>Scent</dt><dd>{{ m.scent.value }}</dd></div>{%- endif -%}
  {%- if m.key_ingredients.value != blank -%}<div><dt>Key ingredients</dt><dd>{{ m.key_ingredients.value }}</dd></div>{%- endif -%}
  {%- if lu_pair.id -%}<div><dt>Pairs with</dt><dd><a href="{% if product.handle == 'long-light-serum' and lu_pair.handle == 'haze-soft-focus-cream' %}#pair{% else %}{{ lu_pair.url }}{% endif %}">{{ lu_pair.title | escape }}</a></dd></div>{%- endif -%}
</dl>
