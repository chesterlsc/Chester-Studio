{%- comment -%}
  LUMORA PDP LEXICON LINE  ·  lu-pdp-lexicon.liquid
  Paste into: Product information > Add block > Custom Liquid, directly BELOW Price.
  Reads custom.lexicon ("long light (n.) the low, raking light of the last hour of sun."): the word or
  words before "(n.)" are set in Fraunces italic. Renders nothing when the metafield is empty.
{%- endcomment -%}
{%- assign lu_lex = product.metafields.custom.lexicon.value | default: '' -%}
{%- if lu_lex != '' -%}
  {%- assign lu_word = lu_lex | split: ' (' | first -%}
  {%- assign lu_rest = lu_lex | remove_first: lu_word -%}
  <p class="lu-pdp-lexicon"><em>{{ lu_word }}</em>{{ lu_rest }}</p>
{%- endif -%}
