<style>
/* Ported PDP base (mockup pdp.css + the lumora.css pieces it relies on), lu- prefixed */
/* Sprite symbols are styled where they live (rules on the <symbol> content reach every <use>) */
[id^="lu-m"] .a{fill:none;stroke:currentColor;stroke-width:1.3;opacity:.5}
[id^="lu-m"] .h{fill:none;stroke:currentColor;stroke-width:1.3;stroke-linecap:round}
[id^="lu-m"] .s{fill:var(--lu-terracotta);stroke:none}
.lu-sundot{fill:var(--lu-honey);stroke:none}
.lu-media{position:relative;overflow:hidden;border-radius:var(--lu-radius);background:var(--lu-sand)}
.lu-media>img{display:block;width:100%;height:100%;object-fit:cover;object-position:var(--pos,50% 50%)}
.lu-r45{aspect-ratio:4/5}
.lu-ico--lg{width:32px;height:32px;stroke-width:1.4}.lu-ico--sm{width:16px;height:16px}
.lu-nowrap{white-space:nowrap}
.lu-sec .lu-ico use,.lu-pdp-info .lu-ico use{pointer-events:none}
.lu-body-copy{margin-top:22px!important;max-width:52ch;color:rgb(var(--color-foreground-secondary))}
.lu-feature{display:grid;grid-template-columns:repeat(12,1fr);column-gap:24px;align-items:center}
.lu-feature__media{grid-column:1/span 6;position:relative}
.lu-feature__text{grid-column:8/span 5}
.lu-feature__text .lu-h2{margin-top:18px}
.lu-media--solo{width:calc(100% - 48px)}
.lu-leaf{position:absolute;inset:0;background:url("{{ 'leaf-light.png' | file_url }}") center/cover no-repeat;opacity:.06;mix-blend-mode:multiply;pointer-events:none;animation:lu-leaf 14s var(--lu-ease) infinite alternate}
.lu-rscene{position:relative;border-radius:var(--lu-radius);overflow:hidden;background:var(--lu-sand)}
.lu-rscene>img{display:block;width:100%;height:100%;object-fit:cover;object-position:var(--pos,50% 50%)}
.lu-rpin{position:absolute;z-index:2;left:var(--x);top:var(--y);width:34px;height:34px;margin:-17px 0 0 -17px;border-radius:50%;display:grid;place-items:center;background:var(--lu-honey);color:var(--lu-dusk);font:600 12px/1 var(--lu-body);letter-spacing:.02em;text-decoration:none;box-shadow:0 0 0 4px var(--lu-glass),0 0 0 12px var(--lu-ring-honey),0 8px 18px -8px var(--lu-ink-shadow)}
.lu-rpin--m{display:none}
.lu-total{display:flex;align-items:baseline;gap:14px}
.lu-total strong{font:300 40px/1 var(--lu-display);letter-spacing:-.02em;color:rgb(var(--color-heading))}
.lu-was{font-size:15px;color:rgb(var(--color-foreground-secondary))}
.lu-save{font:600 12px/1 var(--lu-body);letter-spacing:.12em;text-transform:uppercase;color:var(--lu-clay)}
.lu-disclosure{margin-top:32px;font-size:13px;line-height:20px;color:rgb(var(--color-foreground-secondary))}
.lu-ritual-bg{background:linear-gradient(180deg,var(--lu-honey-wash) 0%,var(--lu-apricot-wash) 100%)!important}
.lu-toggle{position:relative;display:grid;place-items:center;width:32px;height:32px;flex:none;border-radius:50%;box-shadow:inset 0 0 0 1px rgb(var(--color-border))}
.lu-toggle::before,.lu-toggle::after{content:"";position:absolute;left:50%;top:50%;width:13px;height:1.5px;margin:-.75px 0 0 -6.5px;border-radius:1px;background:currentColor;transition:transform var(--lu-fast) var(--lu-ease)}
.lu-toggle::after{transform:rotate(90deg)}
details[open]>summary .lu-toggle{background:var(--lu-honey);color:var(--lu-dusk);box-shadow:none}
details[open]>summary .lu-toggle::after{transform:rotate(0)}
.lu-sec .lu-reassure .lu-ico{width:18px;height:18px}
.lu-sec .lu-reassure::before{display:none}
/* Minimog buy box laid out like the mockup: eyebrow + rating on one row, title + price on the next */
@media (min-width:768px){.m-main-product--info .m-product-info--wrapper{top:24px}}
.m-product-info--wrapper{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:16px;align-content:start}
.m-product-info--wrapper>*{grid-column:1/-1;min-width:0}
.m-product-info--wrapper>.main-product__block-title,.m-product-info--wrapper>.main-product__block-custom_liquid:has(.lu-pdp-eyebrow){grid-column:1}
.m-product-info--wrapper>.main-product__block-price,.m-product-info--wrapper>.main-product__block-custom_liquid:has(.lu-pdp-rating){grid-column:2;margin-top:0!important;align-self:center;justify-self:end;text-align:right}
.m-product-info--wrapper>.main-product__block-price{align-self:start;padding-top:6px}
.main-product__block .m-product-title{margin:0;font:300 44px/1.05 var(--lu-display)!important;letter-spacing:-.02em;text-wrap:balance;color:rgb(var(--color-heading))}
.main-product__block-price .m-price-item{font:300 32px/1 var(--lu-display)!important;letter-spacing:-.01em;color:rgb(var(--color-heading))}
.main-product__block-price .m-price__unit-wrapper,.main-product__block-price .m-product-tax{display:none}
.main-product__block+.main-product__block{margin-top:16px}
.main-product__block-custom_liquid:has(.lu-pdp-lexicon){margin-top:8px!important}
.m-product-option--label{display:flex;align-items:baseline;gap:10px;margin-bottom:10px;font:600 12px/16px var(--lu-body);letter-spacing:.16em;text-transform:uppercase;color:rgb(var(--color-foreground))}
.m-product-option--label .option-label--selected{font:400 13px/16px var(--lu-body);letter-spacing:0;text-transform:none;color:rgb(var(--color-foreground-secondary))}
.m-product-option--button .m-product-option--content{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0}
.m-product-option--button .m-product-option--node__label{display:flex;align-items:center;justify-content:flex-start;height:48px;min-width:0;margin:0;padding:0 20px;border:0;border-radius:var(--lu-pill);background:transparent;box-shadow:inset 0 0 0 1px var(--lu-hairline-strong);font:500 14.5px/1 var(--lu-body);text-transform:none;color:rgb(var(--color-foreground))}
.m-product-option--button .m-product-option--node input:checked+label,.m-product-option--button .m-product-option--node__label[data-selected=true]{background:var(--lu-linen);color:rgb(var(--color-foreground));box-shadow:inset 0 0 0 1.5px var(--lu-dusk)}
.m-product-option--swatch .m-product-option--node__label{width:34px;height:34px}
.m-product-form .m-add-to-cart{width:100%;min-height:56px;margin-top:4px;font-size:16px;background:var(--lu-terracotta);color:var(--lu-linen);border-color:transparent;box-shadow:var(--lu-shadow-btn)}
.m-product-form .m-add-to-cart:hover{background:var(--lu-clay);box-shadow:var(--lu-shadow-btn),var(--lu-halo)}
.main-product__block-buy_buttons .m-quantity{display:none}
.m-product-media .m-image,.m-product-media--item,.m-product-media--slider__thumbnails .swiper-slide{border-radius:var(--lu-radius);overflow:hidden;background:var(--lu-sand)}
.m-breadcrumb,.m-breadcrumb a{font-size:12.5px;line-height:16px;letter-spacing:0;text-transform:none;color:rgb(var(--color-foreground-secondary))}
.m-sticky-addtocart{background:var(--lu-glass);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-top:1px solid var(--lu-hairline);box-shadow:0 -14px 30px -20px var(--lu-ink-shadow);padding-bottom:env(safe-area-inset-bottom)}
.m-sticky-addtocart--title h3{font:400 16px/1.2 var(--lu-display)}
.m-sticky-addtocart .m-add-to-cart{width:auto;min-height:48px;padding:0 18px;background:var(--lu-terracotta);color:var(--lu-linen);border-color:transparent;box-shadow:none}
.m-sticky-addtocart .m-product-option--dropdown-select{border-radius:var(--lu-pill)}
html.stick-atc-show .m-button--scroll-top{bottom:96px}
@media (max-width:767px){
  .lu-feature{display:block}.lu-feature__text{margin-top:36px}.lu-media--solo{width:100%}
  .lu-rscene>img{object-position:var(--pos-m,34% 50%);transform:scale(1.4);transform-origin:50% 53.5%}
  .lu-rpin--d{display:none}.lu-rpin--m{display:grid}
  .lu-total{flex-wrap:wrap;gap:6px 12px}.lu-total strong{font-size:32px}
  .m-breadcrumb,.main-product__block-breadcrumb{display:none}
  .main-product__block .m-product-title{font-size:34px!important}
  .main-product__block-price .m-price-item{font-size:28px!important}
  .m-product-info--wrapper>.main-product__block-custom_liquid:has(.lu-pdp-glance){order:1;margin-top:22px}
  .m-product-info--wrapper>.main-product__block-custom_liquid:has(.lu-pdp-pair),.m-product-info--wrapper>.main-product__block-custom_liquid:has(.lu-pdp-acc),.m-product-info--wrapper>.main-product__block-custom_liquid:has(.lu-pdp-help),.m-product-info--wrapper>.main-product__block-addons{order:2}
  .m-product-option--button .m-product-option--node__label{padding:0 16px;font-size:14px}
  .m-sticky-addtocart .m-add-to-cart{width:100%}
}
@media (prefers-reduced-motion:reduce){.lu-leaf{animation:none}}

/* Buy-box components (mockup pdp.css, section 1) */
.lu-nowrap{white-space: nowrap;}
.lu-pdp-info{position: sticky; top: 24px;}
.lu-pdp-crumb{display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; font-size: 12.5px; line-height: 16px; color: rgb(var(--color-foreground-secondary));}
.lu-pdp-crumb a:hover, .lu-pdp-crumb [aria-current]{color: rgb(var(--color-foreground));}
.lu-pdp-row{display: flex; align-items: center; justify-content: space-between; gap: 16px;}
.lu-pdp-row--top{margin-bottom: 12px;}
.lu-pdp-row--title{align-items: flex-start;}
.lu-pdp-rating{display: inline-flex; align-items: center; gap: 8px; font-size: 13px; line-height: 16px; color: rgb(var(--color-foreground));}
.lu-pdp-rating > .lu-tnum{font-weight: 600;}
.lu-pdp-rating__n{color: rgb(var(--color-foreground-secondary)); text-decoration: underline; text-decoration-color: var(--lu-hairline-strong); text-underline-offset: 3px;}
.lu-tag-sample{display: inline-flex; align-items: center; height: 20px; padding: 0 8px; border-radius: var(--lu-pill); box-shadow: inset 0 0 0 1px var(--lu-hairline-strong); font: 600 9.5px/1 var(--lu-body); letter-spacing: .14em; text-transform: uppercase; color: rgb(var(--color-foreground-secondary));}
.lu-stars{position: relative; display: inline-flex; gap: 2px; color: var(--lu-hairline-strong);}
.lu-stars svg{width: 14px; height: 14px; flex: none; fill: currentColor;}
.lu-stars__fill{position: absolute; left: 0; top: 0; display: flex; gap: 2px; width: var(--r); overflow: hidden; color: var(--lu-dusk);}
.lu-stars--lg svg{width: 20px; height: 20px;}
.lu-pdp-title{font: 300 44px/1.05 var(--lu-display); letter-spacing: -.02em; text-wrap: balance;}
.lu-pdp-price{flex: none; padding-top: 6px; text-align: right;}
.lu-pdp-price > .lu-tnum{display: block; font: 300 32px/1 var(--lu-display); letter-spacing: -.01em;}
.lu-pdp-price small{display: block; margin-top: 6px; font-size: 12px; line-height: 16px; color: rgb(var(--color-foreground-secondary));}
.lu-pdp-lexicon{margin-top: 8px; font: 300 18px/1.4 var(--lu-display); color: rgb(var(--color-foreground));}
.lu-pdp-lexicon em{font-style: italic;}
.lu-pdp-benefits{margin-top: 16px; display: grid; gap: 8px;}
.lu-pdp-benefits li{display: flex; align-items: center; gap: 12px; font-size: 15px; line-height: 22px;}
.lu-pdp-benefits .lu-ico{width: 22px; height: 22px; color: rgb(var(--color-price-sale));}
.lu-pdp-fn{margin-top: 8px; font-size: 12px; line-height: 17px; color: rgb(var(--color-foreground-secondary));}
.lu-pdp-fn .lu-fn{vertical-align: .1em; margin: 0 6px 0 0;}
.lu-pdp-glance{margin-top: 16px; border-top: 1px solid rgb(var(--color-border));}
.lu-pdp-glance > div{display: grid; grid-template-columns: 122px 1fr; gap: 14px; padding: 5px 0; border-bottom: 1px solid rgb(var(--color-border)); font-size: 13px; line-height: 19px;}
.lu-pdp-glance dt{font-weight: 600;}
.lu-pdp-glance dd{color: rgb(var(--color-foreground-secondary));}
.lu-pdp-glance a{color: rgb(var(--color-price-sale)); font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px;}
