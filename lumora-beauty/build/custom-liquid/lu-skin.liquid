  }

  /* 7. Announcement: Honey sun dot between the two promises; the 36-character line on phones */
  function announce(){document.querySelectorAll(".m-announcement-bar__content").forEach(function(el){var tgt=el.querySelector("p")||el;if(tgt.querySelector(".lu-dot"))return;if(window.matchMedia("(max-width:767px)").matches&&LU.mobileAnnouncement&&/·/.test(tgt.textContent)){tgt.textContent=LU.mobileAnnouncement}tgt.innerHTML=tgt.innerHTML.replace(/\s*·\s*/g,'<i class="lu-dot" aria-hidden="true"></i><span class="lu-sr" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">, </span>')})}

  /* 8. One H1 per page: the hero title is the H1 on the home page, the logo is not */
  function oneH1(){var ht=document.querySelector(".lu-hero .m-hero__title");if(!ht||ht.tagName==="H1")return;document.querySelectorAll("h1").forEach(function(h){var d=document.createElement("div");for(var i=0;i<h.attributes.length;i++)d.setAttribute(h.attributes[i].name,h.attributes[i].value);while(h.firstChild)d.appendChild(h.firstChild);h.replaceWith(d)});var h1=document.createElement("h1");for(var j=0;j<ht.attributes.length;j++)h1.setAttribute(ht.attributes[j].name,ht.attributes[j].value);while(ht.firstChild)h1.appendChild(ht.firstChild);ht.replaceWith(h1)}

  function nbsp(){document.querySelectorAll(".m-icon-box__description,.m-section__description,.m-richtext__description").forEach(function(el){if(el.innerHTML.indexOf("Fitzpatrick I to VI")>-1)el.innerHTML=el.innerHTML.replace(/Fitzpatrick I to VI/g,"Fitzpatrick&nbsp;I&nbsp;to&nbsp;VI")})}
  function run(){try{fixEm();nbsp();footMarkers(document.body);cards();sections();announce();oneH1();linkMarkers()}catch(e){if(window.console)console.warn("lu-skin",e)}}
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",run);else run();
  var queued=false;new MutationObserver(function(){if(queued)return;queued=true;requestAnimationFrame(function(){queued=false;try{cards();fixEm()}catch(e){}})}).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>
