---
// Caution ▲ / Danger ⬣ / Tip ◆ — shape carries the meaning, color reinforces it.
import Icon from '../icons/Icon.astro';
interface Props { type?: 'caution' | 'danger' | 'tip'; title: string; }
const { type = 'caution', title } = Astro.props;
const label = { caution: 'Caution', danger: 'Danger — get help', tip: 'Tip' }[type];
---
<aside class:list={['callout', `callout--${type}`]} role="note" aria-label={label}>
  <span class="callout__ico"><Icon name={type} size={30} /></span>
  <div>
    <p class="callout__title"><span class="callout__kind">{label}</span> {title}</p>
    <div class="callout__body"><slot /></div>
  </div>
</aside>
<style>
  .callout { display: grid; grid-template-columns: 36px 1fr; gap: var(--s2); padding: var(--s2) var(--s3) var(--s2) var(--s2); border-radius: var(--radius); border: 3px solid; }
  .callout--caution { background: var(--warn); color: var(--warn-ink); border-color: var(--warn-ink); }
  .callout--danger { background: var(--danger); color: var(--on-danger); border-color: var(--danger); }
  .callout--tip { background: var(--tip-tint); color: var(--ink); border-color: var(--tip); }
  .callout--tip .callout__ico { color: var(--tip); }
  .callout__title { font-weight: 700; line-height: 1.3; }
  .callout__kind { display: block; font-family: var(--font-head); letter-spacing: .12em; text-transform: uppercase; font-size: .95rem; }
  .callout__body :global(p) { margin-top: .25rem; line-height: 1.45; }
  @media print { .callout--danger { background: #fff; color: #000; border-color: #000; } }
</style>
