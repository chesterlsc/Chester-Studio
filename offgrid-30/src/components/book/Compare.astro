---
// Yes / No / Partly comparison chart. Each mark has a shape + word, never color alone.
import Icon from '../icons/Icon.astro';
interface Row { label: string; value: 'yes' | 'no' | 'partly'; note?: string; }
interface Props { title: string; yesLabel?: string; noLabel?: string; rows: Row[]; }
const { title, rows, yesLabel = 'Yes', noLabel = 'No' } = Astro.props;
const word = { yes: yesLabel, no: noLabel, partly: 'Partly' };
---
<section class="b-compare cmp card" aria-label={title}>
  <h3 class="cmp__title">{title}</h3>
  <ul role="list">
    {rows.map((r) => (
      <li class:list={['cmp__row', `is-${r.value}`]}>
        <span class="cmp__mark">
          {r.value === 'yes' && <Icon name="do" size={26} />}
          {r.value === 'no' && <Icon name="dont" size={26} />}
          {r.value === 'partly' && <Icon name="caution" size={26} />}
          <span class="cmp__word">{word[r.value]}</span>
        </span>
        <span class="cmp__label"><b set:html={r.label} />{r.note && <span class="cmp__note" set:html={r.note} />}</span>
      </li>
    ))}
  </ul>
</section>
<style>
  .cmp { padding: var(--s2); }
  .cmp__title { margin-bottom: .5rem; }
  .cmp__row { display: grid; grid-template-columns: 96px 1fr; gap: var(--s2); align-items: center; padding: .6rem 0; border-top: 1px solid var(--rule); }
  .cmp__mark { display: flex; align-items: center; gap: .35rem; font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .is-yes .cmp__mark { color: var(--ok); }
  .is-no .cmp__mark { color: var(--no); }
  .is-partly .cmp__mark { color: var(--ink); }
  .is-partly .cmp__mark :global(.icon) { fill: var(--warn); }
  .cmp__label { line-height: 1.3; }
  .cmp__note { display: block; color: var(--ink-2); font-size: 1rem; }
</style>
