---
import Icon from '../icons/Icon.astro';
import type { IconName } from '../icons/paths';
export type LegendItem = { text: string; icon?: IconName; swatch?: string; num?: string; tone?: 'ok' | 'no' | 'warn' | 'accent' };
interface Props { items: LegendItem[]; }
const { items } = Astro.props;
---
<div class="b-legend legend" role="group" aria-label="Legend">
  <p class="legend__head"><Icon name="legend" size={20} /> Legend</p>
  <ul role="list">
    {items.map((it) => (
      <li>
        <span class:list={['legend__sym', it.tone && `t-${it.tone}`]}>
          {it.icon && <Icon name={it.icon} size={22} />}
          {it.swatch && <span class="sw" style={`background:${it.swatch}`} />}
          {it.num && <span class="num">{it.num}</span>}
        </span>
        <span>{it.text}</span>
      </li>
    ))}
  </ul>
</div>
<style>
  .legend { margin-top: var(--s2); padding: var(--s2); border: 2px dashed var(--rule-strong); border-radius: var(--radius); }
  .legend__head { display: flex; align-items: center; gap: .4rem; font-family: var(--font-head); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; font-size: .95rem; color: var(--ink-2); margin-bottom: .5rem; }
  ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .5rem var(--s2); }
  li { display: flex; align-items: center; gap: .55rem; font-size: 1rem; line-height: 1.25; }
  .legend__sym { flex: none; width: 32px; height: 32px; display: grid; place-items: center; }
  .sw { width: 24px; height: 24px; border-radius: 6px; border: 2px solid var(--ink); }
  .num { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-family: var(--font-head); font-weight: 700; }
  .t-ok { color: var(--ok); } .t-no { color: var(--no); } .t-accent { color: var(--accent-ink); }
  .t-warn :global(.icon) { color: var(--warn-ink); fill: var(--warn); }
</style>
