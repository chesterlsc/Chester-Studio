---
import Icon from '../icons/Icon.astro';
interface Props { when?: string; move: string; }
const { when, move } = Astro.props;
---
<section class="b-scenario" aria-labelledby="pov-h">
  <div class="pov card">
    <p class="pov__label"><Icon name="scenario" size={22} /> <span id="pov-h">Real life</span>{when && <span class="pov__when">· {when}</span>}</p>
    <div class="pov__story"><slot /></div>
    <p class="pov__move"><Icon name="do" size={24} /> <span><b>The right move:</b> <span set:html={move} /></span></p>
  </div>
</section>
<style>
  .pov { padding: var(--s3); border-left: 6px solid var(--accent); background: var(--card); }
  .pov__label { display: flex; align-items: center; gap: .45rem; font-family: var(--font-head); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-ink); font-size: 1rem; margin-bottom: .6rem; }
  .pov__when { letter-spacing: .04em; color: var(--ink-2); text-transform: none; font-weight: 600; }
  .pov__story :global(p) { font-size: calc(var(--fs-body) * 1.04); line-height: 1.6; }
  .pov__story :global(p + p) { margin-top: .6rem; }
  .pov__move { display: flex; gap: .5rem; align-items: flex-start; margin-top: var(--s2); padding: .75rem 1rem; border-radius: var(--radius-sm); background: var(--ok-tint); }
  .pov__move :global(.icon) { color: var(--ok); margin-top: .1em; }
</style>
