---
// 2D fallback for the layered-filter 3D model. Groups carry data-step so the stepper can build it up.
// DESIGN DEMO: layer order is a placeholder until Chapter 5 is fact-checked.
---
<svg class="diagram" viewBox="0 0 360 400" role="img" aria-labelledby="lf2d-t lf2d-d">
  <title id="lf2d-t">Bottle filter, cut-away view</title>
  <desc id="lf2d-d">An upside-down cut bottle. From top to bottom: cloth, fine sand, charcoal, coarse sand, small gravel, cotton plug in the neck. Water drips into a jar below. A warning says the water still needs boiling or bleach.</desc>
  <defs>
    <pattern id="lf-gravel" width="16" height="12" patternUnits="userSpaceOnUse"><rect width="16" height="12" fill="#a19d95"/><circle cx="4" cy="4" r="3" fill="#7c786f"/><circle cx="12" cy="9" r="3.2" fill="#8d8a83"/></pattern>
    <pattern id="lf-coarse" width="8" height="8" patternUnits="userSpaceOnUse"><rect width="8" height="8" fill="#c79e62"/><circle cx="2" cy="2" r="1.3" fill="#9c7643"/><circle cx="6" cy="6" r="1.2" fill="#9c7643"/></pattern>
    <pattern id="lf-fine" width="6" height="6" patternUnits="userSpaceOnUse"><rect width="6" height="6" fill="#e8cf98"/><circle cx="3" cy="3" r=".7" fill="#c3a46a"/></pattern>
    <pattern id="lf-char" width="10" height="10" patternUnits="userSpaceOnUse"><rect width="10" height="10" fill="#2a2a2a"/><path d="M1 3l3-2 3 3-3 2zM5 8l3-2 2 2-2 2z" fill="#4a4a4a"/></pattern>
  </defs>

  <!-- Bottle body (upside down) -->
  <g data-step="1">
    <path d="M110 40 V250 L150 300 V346 H210 V300 L250 250 V40" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round"/>
    <path d="M104 40 h16 M240 40 h16" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-dasharray="4 5"/>
  </g>
  <g data-step="7"><path d="M112 60 q17 -7 34 0 t34 0 t34 0 t34 0 V70 q-17 -7 -34 0 t-34 0 t-34 0 t-34 0z" fill="#7fa7c9" stroke="var(--ink)" stroke-width="1.5"/></g>
  <g data-step="6"><rect x="112" y="70" width="136" height="56" fill="url(#lf-fine)"/></g>
  <g data-step="5"><rect x="112" y="126" width="136" height="48" fill="url(#lf-char)"/></g>
  <g data-step="4"><rect x="112" y="174" width="136" height="46" fill="url(#lf-coarse)"/></g>
  <g data-step="3"><path d="M112 220 H248 V250 L208 300 H152 L112 250z" fill="url(#lf-gravel)"/></g>
  <g data-step="2"><rect x="152" y="300" width="56" height="40" rx="6" fill="#f4f1ea" stroke="var(--ink)" stroke-width="1.5"/></g>

  <!-- Water in, drip out -->
  <g data-step="0" class="lf-flow">
    <path d="M180 6 v24" stroke="var(--part-1)" stroke-width="4" stroke-linecap="round"/>
    <path d="M171 22 l9 10 9-10" fill="none" stroke="var(--part-1)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
  <g data-step="8">
    <path d="M180 352 c-4 6 -6 9 -6 12 a6 6 0 0 0 12 0 c0 -3 -2 -6 -6 -12z" fill="var(--part-1)"/>
    <rect x="140" y="372" width="80" height="24" rx="4" fill="#6fb6e6" stroke="var(--ink)" stroke-width="2"/>
  </g>

  <!-- Labels -->
  <g font-family="var(--font-body)" font-size="15" font-weight="700" fill="var(--ink)">
    <g data-step="7"><path d="M250 64 h20" stroke="var(--ink)" stroke-width="2"/><text x="274" y="69">Cloth</text></g>
    <g data-step="6"><path d="M250 98 h20" stroke="var(--ink)" stroke-width="2"/><text x="274" y="103">Fine sand</text></g>
    <g data-step="5"><path d="M250 150 h20" stroke="var(--ink)" stroke-width="2"/><text x="274" y="155">Charcoal</text></g>
    <g data-step="4"><path d="M250 197 h20" stroke="var(--ink)" stroke-width="2"/><text x="274" y="202">Coarse sand</text></g>
    <g data-step="3"><path d="M244 250 h26" stroke="var(--ink)" stroke-width="2"/><text x="274" y="255">Gravel</text></g>
    <g data-step="2"><path d="M210 320 h60" stroke="var(--ink)" stroke-width="2"/><text x="274" y="325">Cotton</text></g>
    <g data-step="8">
      <path d="M14 356 l14 -24 14 24z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
      <text x="28" y="353" text-anchor="middle" font-size="14">!</text>
      <text x="14" y="378" font-size="14">Clearer ≠ safe.</text>
      <text x="14" y="395" font-size="14">Boil or bleach next.</text>
    </g>
  </g>
</svg>
