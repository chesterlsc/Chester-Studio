---
// 1.5 main visual: daily water per farm animal (bar chart) + pets per body weight.
---
<svg class="diagram" viewBox="0 0 520 924" role="img" aria-labelledby="c1p5-t c1p5-d">
  <title id="c1p5-t">How much water animals drink each day</title>
  <desc id="c1p5-d">Bar chart of water per animal per day. Horse at rest about 30 litres (7.9 gallons), a nursing mare up to about 52 litres (14 gallons). Beef cow in mild weather about 22 litres (5.7 gallons). Milking goat in heat about 15 litres (4 gallons). Goat in heat about 7.4 litres (2 gallons). Growing pig about 7 litres (1.9 gallons). Sheep in mild weather about 2.2 litres (0.6 gallons). Chicken 0.15 to 0.2 litres (5 to 7 ounces). Pets, per kilogram of body weight per day: dog 63 to 73 millilitres (about 1 ounce per pound), cat 50 to 60 millilitres (about 0.8 to 0.9 ounces per pound), rabbit about 120 millilitres (about 1.8 ounces per pound). Heat and milk raise needs: sheep drink about twice as much in warm weather. These are averages from studies; real needs vary.</desc>
  <defs>
    <pattern id="c1p5-hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="9" height="9" fill="var(--card)"/>
      <path d="M0 0 V9" stroke="var(--part-1)" stroke-width="4"/>
    </pattern>
  </defs>

  <!-- Heading -->
  <text x="14" y="36" font-family="var(--font-head)" font-weight="700" font-size="28" fill="var(--ink)">Water per animal, per day</text>

  <!-- Grid: every 10 L -->
  <g stroke="var(--ink-2)" stroke-width="1.5" stroke-dasharray="3 5" opacity=".7">
    <path d="M136 56 V552"/><path d="M200 56 V552"/><path d="M264 56 V552"/><path d="M328 56 V552"/><path d="M392 56 V552"/>
  </g>
  <path d="M72 56 V552" stroke="var(--ink)" stroke-width="3" stroke-linecap="round"/>
  <g font-family="var(--font-body)" font-size="15" font-weight="700" fill="var(--ink-2)" text-anchor="middle">
    <text x="72" y="574">0</text><text x="136" y="574">10 L</text><text x="200" y="574">20 L</text><text x="264" y="574">30 L</text><text x="328" y="574">40 L</text><text x="392" y="574">50 L</text>
  </g>
  <text x="514" y="598" text-anchor="end" font-family="var(--font-body)" font-size="15" fill="var(--ink-2)">Each line = 10 L (2.6 gal)</text>

  <!-- ===== Rows (bar scale: 6.4 units per litre, bars start at x=72) ===== -->
  <g font-family="var(--font-body)" fill="var(--ink)">

    <!-- Horse -->
    <g transform="translate(10 76)" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M44 14 Q53 17 51 33" fill="none" stroke-width="3.5"/>
      <path d="M17 33 V46 M22 33 V46 M38 33 V46 M43 33 V46" stroke-width="3.5"/>
      <path d="M15 13 H41 Q47 13 47 19 V27 Q47 33 41 33 H19 Q13 33 13 27 Z"/>
      <path d="M20 17 L13 2 Q12 0 10 1 L2 9 Q0 11 2 13 L5 15 L11 12 L15 24 Z"/>
      <path d="M12 3 L12 -3 L15 1" />
      <path d="M13 1 L21 15 L24 12 L16 -1 Z" fill="var(--ink)"/>
    </g>
    <text x="78" y="74" font-size="18" font-weight="700">Horse <tspan font-weight="400">at rest</tspan></text>
    <rect x="264" y="82" width="140.8" height="28" fill="url(#c1p5-hatch)" stroke="var(--part-1)" stroke-width="2.5" stroke-dasharray="6 4"/>
    <rect x="72" y="82" width="192" height="28" rx="3" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="84" y="103" font-size="18" font-weight="700" fill="var(--on-part-1)">30 L · 7.9 gal</text>
    <path d="M404.8 112 V128 H392" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <text x="386" y="134" font-size="16" text-anchor="end"><tspan font-weight="700">Nursing mare:</tspan> up to ~52 L (14 gal)</text>

    <!-- Beef cow -->
    <g transform="translate(8 160)" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M50 14 Q55 20 52 30" fill="none" stroke-width="3"/>
      <path d="M19 32 V44 M24 32 V44 M41 32 V44 M46 32 V44" stroke-width="3.5"/>
      <path d="M16 11 H45 Q50 11 50 16 V28 Q50 33 45 33 H19 Q15 33 15 28 Z"/>
      <path d="M28 12 Q34 14 31 21 Q25 22 25 16 Z M40 24 Q46 23 47 30 L40 31 Z" fill="var(--ink)" stroke="none"/>
      <rect x="2" y="9" width="16" height="16" rx="4"/>
      <path d="M4 9 Q0 3 4 1 M16 9 Q20 3 16 1" fill="none"/>
      <circle cx="7" cy="15" r="1.6" fill="var(--ink)" stroke="none"/>
    </g>
    <text x="78" y="158" font-size="18" font-weight="700">Beef cow <tspan font-weight="400">mild weather</tspan></text>
    <rect x="72" y="166" width="140.8" height="28" rx="3" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="222" y="187" font-size="18" font-weight="700">22 L · 5.7 gal</text>

    <!-- Milking goat -->
    <g transform="translate(10 230)" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M43 14 L48 8" stroke-width="3"/>
      <path d="M18 30 V42 M22 30 V42 M37 30 V42 M41 30 V42" stroke-width="3.5"/>
      <path d="M16 13 H40 Q45 13 45 18 V25 Q45 30 40 30 H19 Q14 30 14 25 Z"/>
      <ellipse cx="33" cy="32" rx="5" ry="4" fill="var(--part-5)"/>
      <path d="M19 17 L13 5 L3 9 L5 13 L11 11 L15 23 Z"/>
      <path d="M13 5 Q15 -2 22 1" fill="none" stroke-width="3"/>
      <path d="M5 13 L5 19" stroke-width="3"/>
    </g>
    <text x="78" y="226" font-size="18" font-weight="700">Milking goat <tspan font-weight="400">in heat</tspan></text>
    <rect x="72" y="234" width="96" height="28" rx="3" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="178" y="255" font-size="18" font-weight="700">15 L · 4 gal</text>

    <!-- Goat -->
    <g transform="translate(10 298)" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M43 14 L48 8" stroke-width="3"/>
      <path d="M18 30 V42 M22 30 V42 M37 30 V42 M41 30 V42" stroke-width="3.5"/>
      <path d="M16 13 H40 Q45 13 45 18 V25 Q45 30 40 30 H19 Q14 30 14 25 Z"/>
      <path d="M19 17 L13 5 L3 9 L5 13 L11 11 L15 23 Z"/>
      <path d="M13 5 Q15 -2 22 1" fill="none" stroke-width="3"/>
      <path d="M5 13 L5 19" stroke-width="3"/>
    </g>
    <text x="78" y="294" font-size="18" font-weight="700">Goat <tspan font-weight="400">in heat</tspan></text>
    <rect x="72" y="302" width="47.4" height="28" rx="3" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="130" y="323" font-size="18" font-weight="700">7.4 L · 2 gal</text>

    <!-- Pig -->
    <g transform="translate(8 366)" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M17 30 V40 M23 31 V40 M37 31 V40 M43 30 V40" stroke-width="4"/>
      <ellipse cx="30" cy="21" rx="20" ry="13"/>
      <rect x="3" y="16" width="9" height="11" rx="3"/>
      <path d="M14 11 L17 3 L22 10" />
      <path d="M50 18 Q56 14 55 19 Q54 23 51 20" fill="none"/>
      <circle cx="16" cy="18" r="1.6" fill="var(--ink)" stroke="none"/>
    </g>
    <text x="78" y="362" font-size="18" font-weight="700">Growing pig</text>
    <rect x="72" y="370" width="44.8" height="28" rx="3" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="128" y="391" font-size="18" font-weight="700">7 L · 1.9 gal</text>

    <!-- Sheep -->
    <g transform="translate(8 434)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M20 30 V42 M26 31 V42 M38 31 V42 M44 30 V42" stroke-width="3.5"/>
      <path d="M18 14 Q18 6 26 8 Q30 2 37 7 Q45 5 46 13 Q53 16 49 23 Q51 31 43 31 Q38 36 31 32 Q24 36 20 30 Q12 30 14 22 Q10 16 18 14 Z" fill="var(--card)"/>
      <ellipse cx="9" cy="16" rx="7" ry="9" fill="var(--ink)" transform="rotate(-25 9 16)"/>
    </g>
    <text x="78" y="430" font-size="18" font-weight="700">Sheep <tspan font-weight="400">mild weather</tspan></text>
    <rect x="72" y="438" width="14.1" height="28" rx="2" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="96" y="459" font-size="18" font-weight="700">2.2 L · 0.6 gal</text>

    <!-- Chicken -->
    <g transform="translate(12 500)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M22 34 V44 H18 M30 34 V44 H26" fill="none" stroke-width="3"/>
      <path d="M12 12 Q12 4 19 4 Q26 4 26 12 Q28 20 38 16 L44 8 Q46 24 40 30 Q32 38 22 35 Q12 32 12 22 Z" fill="var(--card)"/>
      <path d="M14 4 Q15 -2 19 1 Q22 -3 24 3" fill="var(--part-4)"/>
      <path d="M12 10 L5 13 L12 15 Z" fill="var(--part-3)"/>
      <path d="M13 18 Q14 24 16 18" fill="var(--part-4)"/>
      <circle cx="18" cy="9.5" r="1.6" fill="var(--ink)" stroke="none"/>
    </g>
    <text x="78" y="498" font-size="18" font-weight="700">Chicken</text>
    <rect x="72" y="506" width="4" height="28" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="88" y="527" font-size="18" font-weight="700">0.15–0.2 L · 5–7 oz</text>
  </g>

  <!-- ===== Pets box ===== -->
  <g transform="translate(8 616)" font-family="var(--font-body)" fill="var(--ink)">
    <rect x="0" y="0" width="504" height="214" rx="12" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="16" y="32" font-family="var(--font-head)" font-weight="700" font-size="23">Pets — per body weight, per day</text>

    <!-- Dog -->
    <g transform="translate(14 50)" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M40 14 Q47 8 46 2" fill="none" stroke-width="3"/>
      <path d="M16 28 V38 M21 28 V38 M34 28 V38 M39 28 V38" stroke-width="3.5"/>
      <path d="M14 13 H37 Q42 13 42 18 V24 Q42 29 37 29 H18 Q13 29 13 24 Z"/>
      <path d="M17 16 L13 6 L5 8 L1 12 L4 15 L11 15 L13 22 Z"/>
      <path d="M12 6 L16 1 L18 9" fill="var(--ink)"/>
    </g>
    <text x="72" y="72" font-size="18" font-weight="700">Dog <tspan font-weight="400">63–73 mL per kg</tspan></text>
    <text x="72" y="94" font-size="16" fill="var(--ink-2)">about 1 oz per lb</text>

    <!-- Cat -->
    <g transform="translate(18 106)" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M30 36 Q42 38 40 26 Q39 18 44 16" fill="none" stroke-width="3"/>
      <path d="M10 38 Q8 22 18 18 Q28 20 28 38 Z"/>
      <path d="M10 12 L9 1 L15 6 H21 L27 1 L26 12 Q26 20 18 20 Q10 20 10 12 Z"/>
      <circle cx="15" cy="12" r="1.5" fill="var(--ink)" stroke="none"/><circle cx="21" cy="12" r="1.5" fill="var(--ink)" stroke="none"/>
    </g>
    <text x="72" y="126" font-size="18" font-weight="700">Cat <tspan font-weight="400">50–60 mL per kg</tspan></text>
    <text x="72" y="148" font-size="16" fill="var(--ink-2)">about 0.8–0.9 oz per lb</text>

    <!-- Rabbit -->
    <g transform="translate(16 162)" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
      <path d="M14 14 Q10 0 14 -2 Q18 0 18 13 M20 13 Q22 -1 26 0 Q29 3 23 15"/>
      <ellipse cx="29" cy="30" rx="15" ry="10"/>
      <circle cx="17" cy="20" r="8"/>
      <circle cx="44" cy="27" r="3"/>
      <circle cx="15" cy="19" r="1.5" fill="var(--ink)" stroke="none"/>
    </g>
    <text x="72" y="180" font-size="18" font-weight="700">Rabbit <tspan font-weight="400">~120 mL per kg</tspan></text>
    <text x="72" y="202" font-size="16" fill="var(--ink-2)">about 1.8 oz per lb</text>

    <!-- Per-kg bars: 1.3 units per mL/kg, start x=316 -->
    <path d="M316 52 V204" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <rect x="316" y="60" width="81.9" height="22" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2"/>
    <rect x="397.9" y="60" width="13" height="22" fill="url(#c1p5-hatch)" stroke="var(--part-1)" stroke-width="2"/>
    <rect x="316" y="114" width="65" height="22" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2"/>
    <rect x="381" y="114" width="13" height="22" fill="url(#c1p5-hatch)" stroke="var(--part-1)" stroke-width="2"/>
    <rect x="316" y="168" width="156" height="22" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2"/>
    <text x="324" y="185" font-size="15" font-weight="700" fill="var(--on-part-1)">most per kg</text>
  </g>

  <!-- ===== Notes ===== -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <path d="M26 848 L40 872 H12 Z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <text x="26" y="868" text-anchor="middle" font-size="15" font-weight="700" fill="var(--warn-ink)">!</text>
    <text x="50" y="862" font-size="17" font-weight="700">Heat and milk raise needs</text>
    <text x="50" y="882" font-size="16">Sheep drink about 2× in warm weather.</text>
    <circle cx="26" cy="905" r="12" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="26" y="911" text-anchor="middle" font-size="16" font-weight="700">≈</text>
    <text x="50" y="911" font-size="16" fill="var(--ink-2)">Averages from studies — real needs vary.</text>
  </g>
</svg>
