---
---
<svg class="diagram" viewBox="0 0 520 590" role="img" aria-labelledby="c1p1-t c1p1-d">
  <title id="c1p1-t">Your body is mostly water</title>
  <desc id="c1p1-d">An older adult and a baby, each filled with water. The baby is about 75 percent water. The older adult is about 55 percent water. A banner says that without water most people die in 3 to 7 days. Four labels show what water does: it keeps your temperature normal by sweating, cushions your joints, protects your spinal cord, and carries waste out as pee, sweat and poop.</desc>
  <defs>
    <clipPath id="c1p1-adult-clip">
      <circle cx="260" cy="162" r="28"/>
      <rect x="249" y="184" width="22" height="22"/>
      <rect x="214" y="198" width="92" height="150" rx="24"/>
      <rect x="190" y="206" width="26" height="128" rx="13"/>
      <rect x="304" y="206" width="26" height="128" rx="13"/>
      <rect x="218" y="328" width="40" height="192" rx="18"/>
      <rect x="262" y="328" width="40" height="192" rx="18"/>
    </clipPath>
    <clipPath id="c1p1-baby-clip">
      <circle cx="440" cy="430" r="24"/>
      <ellipse cx="440" cy="482" rx="30" ry="32"/>
      <ellipse cx="410" cy="476" rx="9" ry="18"/>
      <ellipse cx="470" cy="476" rx="9" ry="18"/>
      <rect x="404" y="502" width="72" height="18" rx="9"/>
    </clipPath>
  </defs>

  <rect width="520" height="590" fill="var(--accent-tint)"/>

  <!-- Banner: 3–7 days -->
  <rect class="c1p1-band" x="12" y="12" width="496" height="88" rx="14" fill="var(--ink)"/>
  <g transform="translate(52 56)" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path class="c1p1-band-fg-s" d="M-20 -32 H20 M-20 32 H20" stroke="var(--paper)" stroke-width="4"/>
    <path d="M-12 -20 H12 C10 -11 5 -7 0 -3 C-5 -7 -10 -11 -12 -20 Z" fill="var(--part-3)"/>
    <path d="M-14 29 C-11 19 -5 16 0 13 C5 16 11 19 14 29 Z" fill="var(--part-3)"/>
    <path class="c1p1-band-fg-s" d="M-15 -32 C-15 -12 -4 -8 -4 0 C-4 8 -15 12 -15 32 M15 -32 C15 -12 4 -8 4 0 C4 8 15 12 15 32" stroke="var(--paper)" stroke-width="3"/>
  </g>
  <text class="c1p1-band-fg" x="90" y="44" font-family="var(--font-body)" font-size="17" font-weight="700" fill="var(--paper)">Without water, most people die in</text>
  <text class="c1p1-band-fg" x="90" y="88" font-family="var(--font-head)" font-size="44" font-weight="700" fill="var(--paper)">3–7 DAYS</text>
  <!-- day strip -->
  <g font-family="var(--font-body)" font-size="15" font-weight="700" text-anchor="middle">
    <g class="c1p1-band-fg-s" fill="none" stroke="var(--paper)" stroke-width="2">
      <rect x="262" y="58" width="30" height="30" rx="5"/>
      <rect x="296" y="58" width="30" height="30" rx="5"/>
    </g>
    <g fill="var(--part-3)" stroke="var(--paper)" stroke-width="2" class="c1p1-band-cell">
      <rect x="330" y="58" width="30" height="30" rx="5"/>
      <rect x="364" y="58" width="30" height="30" rx="5"/>
      <rect x="398" y="58" width="30" height="30" rx="5"/>
      <rect x="432" y="58" width="30" height="30" rx="5"/>
      <rect x="466" y="58" width="30" height="30" rx="5"/>
    </g>
    <text class="c1p1-band-fg" x="277" y="79" fill="var(--paper)">1</text>
    <text class="c1p1-band-fg" x="311" y="79" fill="var(--paper)">2</text>
    <g fill="var(--on-part-3)">
      <text x="345" y="79">3</text><text x="379" y="79">4</text><text x="413" y="79">5</text><text x="447" y="79">6</text><text x="481" y="79">7</text>
    </g>
  </g>

  <!-- Ground -->
  <path d="M160 521 H506" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>

  <!-- Older adult: outline, then fill, then water -->
  <g stroke="var(--ink)" stroke-width="7" fill="var(--card)">
    <circle cx="260" cy="162" r="28"/>
    <rect x="249" y="184" width="22" height="22"/>
    <rect x="214" y="198" width="92" height="150" rx="24"/>
    <rect x="190" y="206" width="26" height="128" rx="13"/>
    <rect x="304" y="206" width="26" height="128" rx="13"/>
    <rect x="218" y="328" width="40" height="192" rx="18"/>
    <rect x="262" y="328" width="40" height="192" rx="18"/>
  </g>
  <g fill="var(--card)">
    <circle cx="260" cy="162" r="28"/>
    <rect x="249" y="184" width="22" height="22"/>
    <rect x="214" y="198" width="92" height="150" rx="24"/>
    <rect x="190" y="206" width="26" height="128" rx="13"/>
    <rect x="304" y="206" width="26" height="128" rx="13"/>
    <rect x="218" y="328" width="40" height="192" rx="18"/>
    <rect x="262" y="328" width="40" height="192" rx="18"/>
  </g>
  <g clip-path="url(#c1p1-adult-clip)">
    <path d="M180 308 q15 -7 30 0 t30 0 t30 0 t30 0 t30 0 t30 0 V530 H180 Z" fill="var(--part-1)" fill-opacity=".5"/>
  </g>
  <!-- grey hair + face -->
  <path d="M233 158 Q233 132 260 132 Q287 132 287 158 Q280 144 260 144 Q240 144 233 158 Z" fill="#B9C2CA" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
  <circle cx="250" cy="162" r="3" fill="var(--ink)"/><circle cx="270" cy="162" r="3" fill="var(--ink)"/>
  <path d="M251 175 Q260 181 269 175" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
  <!-- spine -->
  <g fill="var(--card)" stroke="var(--ink-2)" stroke-width="1.8">
    <rect x="253" y="206" width="14" height="9" rx="3"/><rect x="253" y="218" width="14" height="9" rx="3"/>
    <rect x="253" y="230" width="14" height="9" rx="3"/><rect x="253" y="242" width="14" height="9" rx="3"/>
    <rect x="253" y="254" width="14" height="9" rx="3"/><rect x="253" y="266" width="14" height="9" rx="3"/>
    <rect x="253" y="278" width="14" height="9" rx="3"/><rect x="253" y="290" width="14" height="9" rx="3"/>
    <rect x="253" y="302" width="14" height="9" rx="3"/><rect x="253" y="314" width="14" height="9" rx="3"/>
  </g>
  <!-- cane -->
  <path d="M306 332 Q306 314 322 314 Q338 314 338 332 V519" fill="none" stroke="var(--ink)" stroke-width="6" stroke-linecap="round"/>

  <!-- Baby -->
  <g stroke="var(--ink)" stroke-width="7" fill="var(--card)">
    <circle cx="440" cy="430" r="24"/>
    <ellipse cx="440" cy="482" rx="30" ry="32"/>
    <ellipse cx="410" cy="476" rx="9" ry="18"/>
    <ellipse cx="470" cy="476" rx="9" ry="18"/>
    <rect x="404" y="502" width="72" height="18" rx="9"/>
  </g>
  <g fill="var(--card)">
    <circle cx="440" cy="430" r="24"/>
    <ellipse cx="440" cy="482" rx="30" ry="32"/>
    <ellipse cx="410" cy="476" rx="9" ry="18"/>
    <ellipse cx="470" cy="476" rx="9" ry="18"/>
    <rect x="404" y="502" width="72" height="18" rx="9"/>
  </g>
  <g clip-path="url(#c1p1-baby-clip)">
    <path d="M396 434 q11 -6 22 0 t22 0 t22 0 t22 0 V530 H396 Z" fill="var(--part-1)" fill-opacity=".5"/>
  </g>
  <circle cx="432" cy="426" r="2.6" fill="var(--ink)"/><circle cx="448" cy="426" r="2.6" fill="var(--ink)"/>
  <path d="M434 437 Q440 442 446 437" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round"/>
  <path d="M436 407 q5 -9 11 -2" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round"/>

  <!-- Water level markers -->
  <path d="M174 308 H336" stroke="var(--ink)" stroke-width="2" stroke-dasharray="6 5"/>
  <rect x="104" y="291" width="70" height="34" rx="17" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
  <text x="139" y="317" text-anchor="middle" font-family="var(--font-head)" font-size="27" font-weight="700" fill="var(--ink)">55%</text>
  <path d="M404 434 H478" stroke="var(--ink)" stroke-width="2" stroke-dasharray="6 5"/>
  <rect x="348" y="418" width="56" height="32" rx="16" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
  <text x="376" y="443" text-anchor="middle" font-family="var(--font-head)" font-size="25" font-weight="700" fill="var(--ink)">75%</text>

  <!-- Callout 1: temperature (sweat) -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <path d="M194 124 L241 149" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <path d="M244 141 q5 7 0 11 q-5 -4 0 -11 Z" fill="var(--part-1)" stroke="var(--ink)" stroke-width="1.5"/>
    <g transform="translate(176 120)">
      <circle r="19" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <rect x="-7" y="-13" width="8" height="17" rx="4" fill="var(--card)" stroke="var(--ink)" stroke-width="2"/>
      <circle cx="-3" cy="7" r="5.5" fill="var(--part-4)" stroke="var(--ink)" stroke-width="2"/>
      <path d="M9 -10 q5 7 0 11 q-5 -4 0 -11 Z" fill="var(--part-1)" stroke="var(--ink)" stroke-width="1.5"/>
    </g>
    <text x="150" y="112" text-anchor="end" font-size="16" font-weight="700">Keeps your</text>
    <text x="150" y="131" text-anchor="end" font-size="16" font-weight="700">temperature</text>
    <text x="150" y="150" text-anchor="end" font-size="15">normal (sweat)</text>
  </g>

  <!-- Callout 2: joints -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <path d="M194 440 L232 438" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="238" cy="438" r="6" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2"/>
    <g transform="translate(176 440)">
      <circle r="19" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <path d="M-9 -11 L0 0 L-3 12" fill="none" stroke="var(--ink)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle r="5" fill="var(--part-1)" stroke="var(--ink)" stroke-width="1.5"/>
    </g>
    <text x="150" y="436" text-anchor="end" font-size="16" font-weight="700">Cushions</text>
    <text x="150" y="455" text-anchor="end" font-size="16" font-weight="700">your joints</text>
  </g>

  <!-- Callout 3: spinal cord -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <path d="M338 190 L270 222" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="268" cy="223" r="4" fill="var(--ink)"/>
    <g transform="translate(357 188)">
      <circle r="19" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <path d="M0 -14 V14" stroke="var(--ink)" stroke-width="2"/>
      <g fill="var(--card-2)" stroke="var(--ink)" stroke-width="1.5">
        <rect x="-6" y="-14" width="12" height="5.5" rx="2"/><rect x="-6" y="-6" width="12" height="5.5" rx="2"/>
        <rect x="-6" y="2" width="12" height="5.5" rx="2"/><rect x="-6" y="10" width="12" height="5.5" rx="2"/>
      </g>
    </g>
    <text x="382" y="184" font-size="16" font-weight="700">Protects your</text>
    <text x="382" y="203" font-size="16" font-weight="700">spinal cord</text>
  </g>

  <!-- Callout 4: waste -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <path d="M338 266 L280 326" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="278" cy="328" r="4" fill="var(--ink)"/>
    <g transform="translate(357 262)">
      <circle r="19" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <path d="M-4 -12 C1 -5 4 -1 4 3 A8 8 0 0 1 -12 3 C-12 -1 -9 -5 -4 -12 Z" fill="var(--part-1)" stroke="var(--ink)" stroke-width="1.5"/>
      <path d="M9 -8 V10 M4 5 L9 10 L14 5" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    <text x="382" y="258" font-size="16" font-weight="700">Carries waste</text>
    <text x="382" y="277" font-size="16" font-weight="700">out of you</text>
    <text x="382" y="296" font-size="15">pee, sweat, poop</text>
  </g>

  <!-- Name labels -->
  <g font-family="var(--font-body)" fill="var(--ink)" text-anchor="middle">
    <text x="260" y="550" font-size="17" font-weight="700">Older adult</text>
    <text x="260" y="571" font-size="16">about 55% water</text>
    <text x="440" y="550" font-size="17" font-weight="700">Baby</text>
    <text x="440" y="571" font-size="16">about 75% water</text>
  </g>
</svg>
<style>
  @media print {
    .c1p1-band { fill: #fff; stroke: #000; stroke-width: 3; }
    .c1p1-band-fg { fill: #000; }
    .c1p1-band-fg-s { stroke: #000; }
    .c1p1-band-cell { stroke: #000; }
  }
</style>
