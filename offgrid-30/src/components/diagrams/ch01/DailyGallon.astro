<svg class="diagram" viewBox="0 0 520 590" role="img" aria-labelledby="c1p2-t c1p2-d">
  <title id="c1p2-t">One gallon of water per person per day</title>
  <desc id="c1p2-d">A 1 US gallon jug, which is 3.8 liters, cut open. About three quarters of a gallon, 2.8 liters, is drinking water for an active person. The rest is for cooking and washing. Store at least 3 days and aim for 2 weeks. A ladder shows World Health Organization emergency minimums per person per day: 7.5 liters (2 gallons) as the bare minimum for most people, 15 liters (4 gallons) as the emergency minimum, and 20 liters (5.3 gallons) with basic hygiene.</desc>
  <defs>
    <clipPath id="c1p2-jug-clip">
      <path d="M119 108 V126 L62 170 Q38 188 38 216 V444 Q38 472 66 472 H216 Q244 472 244 444 V216 Q244 188 220 170 L163 126 V108 Z"/>
    </clipPath>
    <g id="c1p2-mj">
      <path d="M8 5 V9 L2 15 V33 Q2 36 5 36 H21 Q24 36 24 33 V15 L18 9 V5 Z" fill="var(--part-1)" fill-opacity=".55" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
      <rect x="7" y="0" width="12" height="6" rx="1.5" fill="var(--ink)"/>
    </g>
  </defs>

  <rect width="520" height="590" fill="var(--accent-tint)"/>

  <!-- Jug title -->
  <g font-family="var(--font-body)" fill="var(--ink)" text-anchor="middle">
    <text x="146" y="38" font-family="var(--font-head)" font-size="30" font-weight="700">1 US GALLON (3.8 L)</text>
    <text x="146" y="62" font-size="17" font-weight="700">per person, per day</text>
  </g>

  <!-- Handle -->
  <path d="M184 138 H236 Q256 138 256 158 V232" fill="none" stroke="var(--ink)" stroke-width="22" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M184 138 H236 Q256 138 256 158 V232" fill="none" stroke="var(--card)" stroke-width="15" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- Jug body -->
  <path d="M119 108 V126 L62 170 Q38 188 38 216 V444 Q38 472 66 472 H216 Q244 472 244 444 V216 Q244 188 220 170 L163 126 V108 Z" fill="var(--card)"/>
  <g clip-path="url(#c1p2-jug-clip)">
    <path d="M30 198 q12 -6 24 0 t24 0 t24 0 t24 0 t24 0 t24 0 t24 0 t24 0 t24 0 V264 H30 Z" fill="var(--part-7)" fill-opacity=".5"/>
    <rect x="30" y="264" width="230" height="212" fill="var(--part-1)" fill-opacity=".55"/>
    <path d="M56 236 V440" stroke="#FFFFFF" stroke-opacity=".55" stroke-width="7" stroke-linecap="round"/>
  </g>
  <path d="M38 264 H244" stroke="var(--ink)" stroke-width="2.5" stroke-dasharray="8 6"/>
  <path d="M119 108 V126 L62 170 Q38 188 38 216 V444 Q38 472 66 472 H216 Q244 472 244 444 V216 Q244 188 220 170 L163 126 V108 Z" fill="none" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"/>
  <rect x="111" y="84" width="60" height="26" rx="5" fill="var(--accent)" stroke="var(--ink)" stroke-width="3"/>
  <path d="M123 90 V104 M135 90 V104 M147 90 V104 M159 90 V104" stroke="var(--on-accent)" stroke-width="2" stroke-linecap="round"/>

  <!-- Band labels -->
  <g font-family="var(--font-body)" fill="var(--ink)" text-anchor="middle">
    <text x="141" y="227" font-size="16">The rest:</text>
    <text x="141" y="250" font-size="17" font-weight="700">cooking + washing</text>

    <text x="141" y="322" font-family="var(--font-head)" font-size="54" font-weight="700">¾ gal</text>
    <text x="141" y="350" font-size="20" font-weight="700">(2.8 L)</text>
    <text x="141" y="384" font-size="21" font-weight="700">Drinking</text>
    <text x="141" y="406" font-size="16">active person</text>
  </g>
  <!-- cup icon -->
  <path d="M124 420 H158 L153 456 H129 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <path d="M126.5 432 H155.5 L153 452 H129.5 Z" fill="var(--part-1)" fill-opacity=".7"/>

  <!-- WHO ladder -->
  <rect x="286" y="12" width="224" height="462" rx="14" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <text x="300" y="40" font-size="18" font-weight="700">WHO emergency</text>
    <text x="300" y="61" font-size="18" font-weight="700">minimums</text>
    <text x="300" y="82" font-size="15" fill="var(--ink-2)">per person, per day</text>

    <path d="M300 96 H496 M300 200 H496 M300 304 H496 M300 404 H496" stroke="var(--rule-strong)" stroke-width="1.5"/>

    <text x="300" y="126"><tspan font-family="var(--font-head)" font-size="31" font-weight="700">20 L</tspan><tspan font-size="17" font-weight="700" dx="6">(5.3 gal)</tspan></text>
    <text x="300" y="147" font-size="15">with basic hygiene</text>

    <text x="300" y="230"><tspan font-family="var(--font-head)" font-size="31" font-weight="700">15 L</tspan><tspan font-size="17" font-weight="700" dx="6">(4 gal)</tspan></text>
    <text x="300" y="251" font-size="15">emergency minimum</text>

    <text x="300" y="334"><tspan font-family="var(--font-head)" font-size="31" font-weight="700">7.5 L</tspan><tspan font-size="17" font-weight="700" dx="6">(2 gal)</tspan></text>
    <text x="300" y="355" font-size="15">bare minimum</text>
  </g>
  <!-- jug rows -->
  <use href="#c1p2-mj" x="300" y="156"/><use href="#c1p2-mj" x="332" y="156"/><use href="#c1p2-mj" x="364" y="156"/>
  <use href="#c1p2-mj" x="396" y="156"/><use href="#c1p2-mj" x="428" y="156"/>
  <g transform="translate(460 156)">
    <path d="M8 5 V9 L2 15 V33 Q2 36 5 36 H21 Q24 36 24 33 V15 L18 9 V5 Z" fill="var(--card)"/>
    <path d="M2 24 V33 Q2 36 5 36 H21 Q24 36 24 33 V24 Z" fill="var(--part-1)" fill-opacity=".55"/>
    <path d="M8 5 V9 L2 15 V33 Q2 36 5 36 H21 Q24 36 24 33 V15 L18 9 V5 Z" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
    <rect x="7" y="0" width="12" height="6" rx="1.5" fill="var(--ink)"/>
  </g>
  <use href="#c1p2-mj" x="300" y="260"/><use href="#c1p2-mj" x="332" y="260"/><use href="#c1p2-mj" x="364" y="260"/><use href="#c1p2-mj" x="396" y="260"/>
  <use href="#c1p2-mj" x="300" y="364"/><use href="#c1p2-mj" x="332" y="364"/>
  <!-- key -->
  <use href="#c1p2-mj" x="300" y="422"/>
  <text x="334" y="447" font-family="var(--font-body)" font-size="15" font-weight="700" fill="var(--ink)">= 1 US gal (3.8 L)</text>

  <!-- Store badge -->
  <rect x="12" y="488" width="496" height="92" rx="14" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
  <text x="26" y="517" font-family="var(--font-body)" font-size="17" font-weight="700" fill="var(--ink)">Store at least 3 days · aim for 2 weeks</text>
  <g stroke="var(--ink)" stroke-width="1.5">
    <rect x="24" y="532" width="30" height="34" rx="5" fill="var(--accent)"/>
    <rect x="58" y="532" width="30" height="34" rx="5" fill="var(--accent)"/>
    <rect x="92" y="532" width="30" height="34" rx="5" fill="var(--accent)"/>
    <g fill="var(--accent-tint)">
      <rect x="126" y="532" width="30" height="34" rx="5"/><rect x="160" y="532" width="30" height="34" rx="5"/>
      <rect x="194" y="532" width="30" height="34" rx="5"/><rect x="228" y="532" width="30" height="34" rx="5"/>
      <rect x="262" y="532" width="30" height="34" rx="5"/><rect x="296" y="532" width="30" height="34" rx="5"/>
      <rect x="330" y="532" width="30" height="34" rx="5"/><rect x="364" y="532" width="30" height="34" rx="5"/>
      <rect x="398" y="532" width="30" height="34" rx="5"/><rect x="432" y="532" width="30" height="34" rx="5"/>
      <rect x="466" y="532" width="30" height="34" rx="5"/>
    </g>
  </g>
  <g font-family="var(--font-body)" font-size="15" font-weight="700" text-anchor="middle">
    <g fill="var(--on-accent)"><text x="39" y="555">1</text><text x="73" y="555">2</text><text x="107" y="555">3</text></g>
    <g fill="var(--ink)">
      <text x="141" y="555">4</text><text x="175" y="555">5</text><text x="209" y="555">6</text><text x="243" y="555">7</text>
      <text x="277" y="555">8</text><text x="311" y="555">9</text><text x="345" y="555">10</text><text x="379" y="555">11</text>
      <text x="413" y="555">12</text><text x="447" y="555">13</text><text x="481" y="555">14</text>
    </g>
  </g>
</svg>
