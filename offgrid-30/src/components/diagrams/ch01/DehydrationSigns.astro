---
<svg class="diagram" viewBox="0 0 520 648" role="img" aria-labelledby="c1p3-t c1p3-d">
  <title id="c1p3-t">Signs of dehydration</title>
  <desc id="c1p3-d">Left: an adult or child with signs of dehydration: thirsty; headache and dizzy; dry mouth and lips; tired; sunken eyes; dark, strong-smelling pee; peeing less. Right: a baby with signs: a sunken soft spot on top of the head; few or no tears; no wet diaper for 3 hours or more; unusually sleepy. Babies, children and older adults are more at risk. Bottom, danger: get help now for confusion, fainting, no pee, fast heartbeat or fast breathing.</desc>

  <rect width="520" height="648" fill="var(--accent-tint)"/>

  <!-- ===== Left panel: adults & children ===== -->
  <rect x="8" y="8" width="294" height="516" rx="14" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
  <text x="22" y="38" font-family="var(--font-body)" font-size="19" font-weight="700" fill="var(--ink)">Adults &amp; children</text>

  <!-- figure: outline, then fill -->
  <g stroke="var(--ink)" stroke-width="6.5" fill="var(--card-2)">
    <circle cx="76" cy="112" r="38"/>
    <rect x="66" y="146" width="20" height="16"/>
    <rect x="40" y="158" width="72" height="160" rx="20"/>
    <rect x="20" y="172" width="20" height="132" rx="10"/>
    <rect x="112" y="172" width="20" height="132" rx="10"/>
    <rect x="44" y="302" width="30" height="208" rx="13"/>
    <rect x="78" y="302" width="30" height="208" rx="13"/>
  </g>
  <g fill="var(--card-2)">
    <circle cx="76" cy="112" r="38"/>
    <rect x="66" y="146" width="20" height="16"/>
    <rect x="40" y="158" width="72" height="160" rx="20"/>
    <rect x="20" y="172" width="20" height="132" rx="10"/>
    <rect x="112" y="172" width="20" height="132" rx="10"/>
    <rect x="44" y="302" width="30" height="208" rx="13"/>
    <rect x="78" y="302" width="30" height="208" rx="13"/>
  </g>
  <!-- face: heavy lids, sunken eye shadows, dry cracked lips -->
  <g fill="none" stroke="var(--ink)" stroke-linecap="round">
    <path d="M54 106 H70 M82 106 H98" stroke-width="3"/>
    <path d="M55 107 Q62 114 69 107 M83 107 Q90 114 97 107" stroke-width="2"/>
    <path d="M54 118 Q62 124 70 118 M82 118 Q90 124 98 118" stroke="var(--ink-2)" stroke-width="2.5"/>
    <path d="M64 134 Q76 129 88 134" stroke-width="3"/>
    <path d="M70 131 l-1 5 M76 130 v5 M82 131 l1 5" stroke-width="1.6"/>
  </g>
  <!-- headache / dizzy marks -->
  <g fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round">
    <path d="M100 74 l7 -8 M110 86 l10 -3 M90 68 l2 -10"/>
  </g>
  <!-- low battery on chest = tired -->
  <g transform="translate(60 206)">
    <rect x="0" y="0" width="30" height="16" rx="3" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <rect x="30" y="5" width="4" height="6" rx="1" fill="var(--ink)"/>
    <rect x="3.5" y="3.5" width="6" height="9" rx="1" fill="var(--part-4)"/>
  </g>
  <!-- pee jar: dark and low -->
  <g>
    <rect x="118" y="412" width="32" height="8" rx="3" fill="var(--ink)"/>
    <path d="M120 420 H148 V462 Q148 470 140 470 H128 Q120 470 120 462 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <path d="M122.5 452 H145.5 V462 Q145.5 467.5 140 467.5 H128 Q122.5 467.5 122.5 462 Z" fill="#C98A00"/>
    <path d="M120 452 H148" stroke="var(--ink)" stroke-width="2"/>
    <path d="M123 430 H145" stroke="var(--ink-2)" stroke-width="2" stroke-dasharray="4 3"/>
    <path d="M134 433 V446 M129.5 441.5 L134 446 L138.5 441.5" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- left labels -->
  <g font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)">
    <g stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round">
      <path d="M146 64 L114 74"/>
      <path d="M146 104 L100 112"/>
      <path d="M146 142 L90 133"/>
      <path d="M146 182 L88 154"/>
      <path d="M146 234 L96 216"/>
      <path d="M156 410 Q156 462 141 462"/>
      <path d="M164 470 L141 440"/>
    </g>
    <g fill="var(--ink)">
      <circle cx="112" cy="75" r="3.5"/><circle cx="98" cy="112" r="3.5"/><circle cx="88" cy="133" r="3.5"/>
      <circle cx="86" cy="154" r="3.5"/><circle cx="94" cy="215" r="3.5"/>
    </g>
    <text x="152" y="69">Headache, dizzy</text>
    <text x="152" y="109">Sunken eyes</text>
    <text x="152" y="147">Dry mouth &amp; lips</text>
    <text x="152" y="187">Thirsty</text>
    <text x="152" y="239">Tired</text>
    <text x="152" y="386">Dark, strong-</text>
    <text x="152" y="405">smelling pee</text>
    <text x="168" y="488">Peeing less</text>
    <circle cx="140" cy="461" r="3.5"/>
    <circle cx="140" cy="439" r="3.5"/>
  </g>

  <!-- ===== Right panel: babies ===== -->
  <rect x="310" y="8" width="202" height="516" rx="14" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
  <text x="324" y="38" font-family="var(--font-body)" font-size="19" font-weight="700" fill="var(--ink)">Babies</text>

  <g stroke="var(--ink)" stroke-width="6" fill="var(--card-2)">
    <circle cx="370" cy="174" r="44"/>
    <rect x="336" y="214" width="68" height="76" rx="18"/>
    <ellipse cx="330" cy="246" rx="9" ry="22"/>
    <ellipse cx="410" cy="246" rx="9" ry="22"/>
    <rect x="340" y="310" width="22" height="36" rx="10"/>
    <rect x="378" y="310" width="22" height="36" rx="10"/>
  </g>
  <g fill="var(--card-2)">
    <circle cx="370" cy="174" r="44"/>
    <rect x="336" y="214" width="68" height="76" rx="18"/>
    <ellipse cx="330" cy="246" rx="9" ry="22"/>
    <ellipse cx="410" cy="246" rx="9" ry="22"/>
    <rect x="340" y="310" width="22" height="36" rx="10"/>
    <rect x="378" y="310" width="22" height="36" rx="10"/>
  </g>
  <!-- diaper (dry) -->
  <path d="M330 282 H410 V298 Q410 322 386 322 H354 Q330 322 330 298 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round"/>
  <!-- sunken soft spot -->
  <path d="M352 134 Q370 146 388 134" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round"/>
  <!-- closed sleepy eyes -->
  <path d="M348 172 q8 6 16 0 M376 172 q8 6 16 0" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round"/>
  <!-- no tear: empty dashed drop -->
  <path d="M386 182 q6 9 0 13 q-6 -4 0 -13 Z" fill="none" stroke="var(--ink-2)" stroke-width="1.8" stroke-dasharray="3 2.5"/>
  <path d="M362 198 q8 -3 16 0" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>

  <g font-family="var(--font-body)" font-weight="700" fill="var(--ink)">
    <g stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" fill="none">
      <path d="M370 96 V136"/>
      <path d="M420 150 L392 170"/>
      <path d="M420 206 L393 192"/>
      <path d="M370 360 V324"/>
    </g>
    <circle cx="370" cy="138" r="3.5"/>
    <circle cx="391" cy="171" r="3.5"/>
    <circle cx="392" cy="191" r="3.5"/>
    <circle cx="370" cy="324" r="3.5"/>
    <text x="324" y="68" font-size="16">Sunken soft spot</text>
    <text x="324" y="87" font-size="16">on top of head</text>
    <text x="424" y="146" font-size="15">Unusually</text>
    <text x="424" y="164" font-size="15">sleepy</text>
    <text x="424" y="206" font-size="15">Few or</text>
    <text x="424" y="224" font-size="15">no tears</text>
    <text x="324" y="380" font-size="16">No wet diaper</text>
    <text x="324" y="399" font-size="16">for 3+ hours</text>
  </g>
  <!-- clock -->
  <g transform="translate(478 388)">
    <circle r="16" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <path d="M0 -10 V0 L7 5" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
  <!-- caution: higher risk -->
  <g transform="translate(324 432)">
    <path d="M14 0 L28 24 H0 Z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
    <path d="M14 8 V15" stroke="var(--warn-ink)" stroke-width="2.6" stroke-linecap="round"/>
    <circle cx="14" cy="19.5" r="1.6" fill="var(--warn-ink)"/>
  </g>
  <g font-family="var(--font-body)" font-size="15" fill="var(--ink)">
    <text x="358" y="448" font-weight="700">More at risk:</text>
    <text x="358" y="468">babies, children</text>
    <text x="358" y="487">and older adults</text>
  </g>

  <!-- ===== Danger strip ===== -->
  <rect class="c1p3-danger" x="8" y="534" width="504" height="106" rx="14" fill="var(--danger)"/>
  <g transform="translate(50 587)">
    <path class="c1p3-danger-s" d="M27.7 11.5 L11.5 27.7 L-11.5 27.7 L-27.7 11.5 L-27.7 -11.5 L-11.5 -27.7 L11.5 -27.7 L27.7 -11.5 Z" fill="none" stroke="var(--on-danger)" stroke-width="3.5" stroke-linejoin="round"/>
    <path class="c1p3-danger-s" d="M0 -14 V5" stroke="var(--on-danger)" stroke-width="5" stroke-linecap="round"/>
    <circle class="c1p3-danger-f" cy="14" r="3.2" fill="var(--on-danger)"/>
  </g>
  <g class="c1p3-danger-f" font-family="var(--font-body)" fill="var(--on-danger)">
    <text x="96" y="566" font-size="21" font-weight="700">Get help now:</text>
    <text x="96" y="593" font-size="17" font-weight="700">confusion · fainting · no pee ·</text>
    <text x="96" y="618" font-size="17" font-weight="700">fast heartbeat · fast breathing</text>
  </g>
</svg>
<style>
  @media print {
    .c1p3-danger { fill: #fff; stroke: #000; stroke-width: 4; }
    .c1p3-danger-s { stroke: #000; }
    .c1p3-danger-f { fill: #000; }
  }
</style>
