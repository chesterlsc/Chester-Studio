---
---
<svg class="diagram" viewBox="0 0 520 714" role="img" aria-labelledby="c1p4-t c1p4-d">
  <title id="c1p4-t">Who needs extra water</title>
  <desc id="c1p4-d">Six cards. Very hot weather: water needs can double. Hard work in heat: drink 1 cup (237 milliliters, 8 ounces) every 15 to 20 minutes. Fever, vomiting or diarrhea: drink early, don't wait for signs. Pregnant or breastfeeding: needs more water. Children under 5 and adults 65 and over: higher risk, give plenty of fluids. Babies 6 to 12 months: 4 to 8 ounces (118 to 237 milliliters) of water a day. Caution: huge amounts of plain water drunk fast can also harm.</desc>

  <rect width="520" height="714" fill="var(--accent-tint)"/>

  <!-- Card frames -->
  <g fill="var(--card)" stroke="var(--ink)" stroke-width="2.5">
    <rect x="8" y="8" width="248" height="194" rx="14"/>
    <rect x="264" y="8" width="248" height="194" rx="14"/>
    <rect x="8" y="210" width="248" height="194" rx="14"/>
    <rect x="264" y="210" width="248" height="194" rx="14"/>
    <rect x="8" y="412" width="248" height="194" rx="14"/>
    <rect x="264" y="412" width="248" height="194" rx="14"/>
  </g>
  <!-- Icon backdrops -->
  <g fill="var(--accent-tint)">
    <circle cx="64" cy="64" r="46"/><circle cx="320" cy="64" r="46"/>
    <circle cx="64" cy="266" r="46"/><circle cx="320" cy="266" r="46"/>
    <circle cx="64" cy="468" r="46"/><circle cx="320" cy="468" r="46"/>
  </g>

  <!-- 1. Heat -->
  <g transform="translate(8 8)">
    <g stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round">
      <path d="M40 18 V26 M40 74 V82 M8 50 H16 M64 50 H70 M17 27 l6 6 M57 67 l5 5 M17 73 l6 -6 M57 33 l5 -5"/>
    </g>
    <circle cx="40" cy="50" r="16" fill="var(--part-3)" stroke="var(--ink)" stroke-width="2.5"/>
    <rect x="76" y="22" width="14" height="56" rx="7" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <rect x="80" y="30" width="6" height="50" rx="3" fill="var(--part-4)"/>
    <circle cx="83" cy="84" r="11" fill="var(--part-4)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="118" y="80" font-family="var(--font-head)" font-size="56" font-weight="700" fill="var(--ink)">×2</text>
    <g font-family="var(--font-body)" fill="var(--ink)">
      <text x="14" y="132" font-size="17" font-weight="700">Very hot weather</text>
      <text x="14" y="156" font-size="16">water needs can</text>
      <text x="14" y="178" font-size="16" font-weight="700">DOUBLE</text>
    </g>
  </g>

  <!-- 2. Hard work in heat -->
  <g transform="translate(264 8)">
    <path d="M22 40 H62 L56 94 H28 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <path d="M24.5 54 H59.5 L54.6 91.5 H29.4 Z" fill="var(--part-1)" fill-opacity=".6"/>
    <circle cx="80" cy="38" r="17" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <path d="M75 17 H85 M80 17 V21" stroke="var(--ink)" stroke-width="3" stroke-linecap="round"/>
    <path d="M80 38 V27 M80 38 L88 43" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <text x="114" y="78" font-family="var(--font-head)" font-size="50" font-weight="700" fill="var(--ink)">1 cup</text>
    <g font-family="var(--font-body)" fill="var(--ink)">
      <text x="14" y="132" font-size="17" font-weight="700">Hard work in heat</text>
      <text x="14" y="156" font-size="16">every 15–20 min</text>
      <text x="14" y="178" font-size="16">(237 mL / 8 oz)</text>
    </g>
  </g>

  <!-- 3. Fever, vomiting, diarrhea -->
  <g transform="translate(8 210)">
    <circle cx="50" cy="56" r="32" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <path d="M36 48 l8 4 M64 48 l-8 4" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <path d="M38 72 q6 -6 12 0 q6 6 12 0" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <path d="M24 30 q5 7 0 11 q-5 -4 0 -11 Z" fill="var(--part-1)" stroke="var(--ink)" stroke-width="1.5"/>
    <path d="M66 80 L96 98" stroke="var(--ink)" stroke-width="8" stroke-linecap="round"/>
    <path d="M66 80 L96 98" stroke="var(--card)" stroke-width="3.5" stroke-linecap="round"/>
    <circle cx="96" cy="98" r="5" fill="var(--part-4)" stroke="var(--ink)" stroke-width="2"/>
    <text x="116" y="78" font-family="var(--font-head)" font-size="46" font-weight="700" fill="var(--ink)">EARLY</text>
    <g font-family="var(--font-body)" fill="var(--ink)">
      <text x="14" y="132" font-size="17" font-weight="700">Fever, vomiting,</text>
      <text x="14" y="154" font-size="17" font-weight="700">diarrhea</text>
      <text x="14" y="178" font-size="16">drink early, don’t wait</text>
    </g>
  </g>

  <!-- 4. Pregnant or breastfeeding -->
  <g transform="translate(264 210)">
    <circle cx="44" cy="26" r="12" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5"/>
    <path d="M36 42 H54 Q60 46 60 56 Q80 62 80 78 Q80 92 62 94 L62 104 H34 L34 94 Q28 68 36 42 Z" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <path d="M88 26 C95 36 98 41 98 46 A10 10 0 0 1 78 46 C78 41 81 36 88 26 Z" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2"/>
    <path d="M88 39 V51 M82 45 H94" stroke="var(--on-part-1)" stroke-width="2.5" stroke-linecap="round"/>
    <text x="114" y="78" font-family="var(--font-head)" font-size="50" font-weight="700" fill="var(--ink)">MORE</text>
    <g font-family="var(--font-body)" fill="var(--ink)">
      <text x="14" y="132" font-size="17" font-weight="700">Pregnant or</text>
      <text x="14" y="154" font-size="17" font-weight="700">breastfeeding</text>
      <text x="14" y="178" font-size="16">needs more water</text>
    </g>
  </g>

  <!-- 5. Under 5 and 65+ -->
  <g transform="translate(8 412)">
    <g fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round">
      <circle cx="30" cy="54" r="9"/>
      <rect x="21" y="65" width="18" height="24" rx="6"/>
      <rect x="23" y="86" width="14" height="14" rx="4"/>
      <circle cx="66" cy="30" r="11"/>
      <rect x="55" y="43" width="22" height="36" rx="8"/>
      <rect x="57" y="76" width="18" height="24" rx="5"/>
    </g>
    <path d="M56 26 Q56 18 66 18 Q76 18 76 26 Q71 22 66 22 Q61 22 56 26 Z" fill="#B9C2CA" stroke="var(--ink)" stroke-width="1.5"/>
    <path d="M78 66 Q78 58 85 58 Q92 58 92 66 V100" fill="none" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round"/>
    <text x="110" y="60" font-family="var(--font-head)" font-size="36" font-weight="700" fill="var(--ink)">UNDER 5</text>
    <text x="110" y="96" font-family="var(--font-head)" font-size="36" font-weight="700" fill="var(--ink)">&amp; 65+</text>
    <g font-family="var(--font-body)" fill="var(--ink)">
      <text x="14" y="132" font-size="17" font-weight="700">Young kids and</text>
      <text x="14" y="154" font-size="17" font-weight="700">older adults</text>
      <text x="14" y="178" font-size="16">higher risk: give fluids</text>
    </g>
  </g>

  <!-- 6. Babies 6–12 months -->
  <g transform="translate(264 412)">
    <circle cx="40" cy="54" r="24" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5"/>
    <circle cx="32" cy="52" r="2.6" fill="var(--ink)"/><circle cx="48" cy="52" r="2.6" fill="var(--ink)"/>
    <path d="M34 63 Q40 68 46 63" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M36 31 q5 -9 11 -2" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M78 44 H92 L94 52 H76 Z" fill="var(--accent)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
    <rect x="72" y="52" width="26" height="40" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <path d="M74.5 68 H95.5 V86 Q95.5 89.5 92 89.5 H78 Q74.5 89.5 74.5 86 Z" fill="var(--part-1)" fill-opacity=".6"/>
    <text x="110" y="78" font-family="var(--font-head)" font-size="46" font-weight="700" fill="var(--ink)">4–8 oz</text>
    <g font-family="var(--font-body)" fill="var(--ink)">
      <text x="14" y="132" font-size="17" font-weight="700">Babies 6–12 months</text>
      <text x="14" y="156" font-size="16">(118–237 mL)</text>
      <text x="14" y="178" font-size="16">of water a day</text>
    </g>
  </g>

  <!-- Caution -->
  <rect x="8" y="614" width="504" height="92" rx="14" fill="var(--part-6-tint)" stroke="var(--ink)" stroke-width="2.5"/>
  <g transform="translate(24 640)">
    <path d="M20 0 L40 36 H0 Z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <path d="M20 12 V23" stroke="var(--warn-ink)" stroke-width="3.5" stroke-linecap="round"/>
    <circle cx="20" cy="29.5" r="2.2" fill="var(--warn-ink)"/>
  </g>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <text x="80" y="652" font-size="18" font-weight="700">Huge amounts of plain water</text>
    <text x="80" y="678" font-size="18" font-weight="700">fast can also harm.</text>
  </g>
</svg>
