---
// 1.6 main visual: house cut-away showing safe (✓) and unsafe (✕) water already inside the home.
---
<svg class="diagram" viewBox="0 0 520 820" role="img" aria-labelledby="c1p6-t c1p6-d">
  <title id="c1p6-t">Hidden water already in your home</title>
  <desc id="c1p6-d">A two-floor house cut open. Safe sources, marked with a check: 1, the water heater (the tank for your taps, not the heating system); 2, the water in the pipes: open the highest tap to let air in, then collect from the lowest tap; 3, melted ice cubes; 4, the toilet tank, not the bowl, only if it is clear and no cleaner was added, and treat it before drinking; 5, the liquid in canned fruit and vegetables. Never drink, marked with a cross: the toilet bowl, radiators and the heating boiler, and a waterbed. A pool or spa, marked with a warning triangle, is for washing only, not for drinking. To drain the water heater: turn the power or gas off, close the cold water inlet, open a hot tap, then drain from the valve at the bottom.</desc>
  <defs>
    <g id="c1p6-ok">
      <circle r="12" fill="var(--ok)" stroke="var(--card)" stroke-width="2"/>
      <path d="M-5.5 0.5 L-1.5 4.5 L5.5 -4" fill="none" stroke="var(--card)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    <g id="c1p6-no">
      <rect x="-11" y="-11" width="22" height="22" rx="3" fill="var(--no)" stroke="var(--card)" stroke-width="2"/>
      <path d="M-5 -5 L5 5 M5 -5 L-5 5" stroke="var(--card)" stroke-width="3" stroke-linecap="round"/>
    </g>
  </defs>

  <!-- ===== House shell ===== -->
  <path d="M2 120 L260 22 L518 120 Z" fill="var(--card-2)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"/>
  <rect x="10" y="120" width="500" height="334" fill="var(--card)" stroke="var(--ink)" stroke-width="3.5"/>
  <path d="M10 288 H510" stroke="var(--ink)" stroke-width="6"/>
  <path d="M252 120 V288 M252 288 V454" stroke="var(--ink)" stroke-width="3"/>
  <!-- Ground + yard -->
  <rect x="0" y="454" width="520" height="92" fill="var(--part-3-tint)"/>
  <path d="M0 454 H520" stroke="var(--ink)" stroke-width="3.5"/>

  <!-- ===== Supply pipe (blue) from the highest tap down to the lowest tap ===== -->
  <path d="M24 200 V410" stroke="var(--part-1)" stroke-width="6" stroke-linecap="round"/>

  <!-- ===== Upstairs left: bathroom ===== -->
  <!-- Sink + highest tap -->
  <path d="M24 200 H58 V210" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M38 216 H98 Q96 234 68 234 Q40 234 38 216 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <rect x="61" y="234" width="14" height="54" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
  <!-- air arrow into the tap -->
  <path d="M78 176 Q66 180 62 196" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M56 190 L62 200 L68 191" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="34" cy="146" r="14" fill="var(--accent)"/>
    <text x="34" y="152" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">2</text>
    <text x="54" y="152" font-size="16" font-weight="700">Highest tap</text>
    <text x="82" y="174" font-size="15">open: air in</text>
  </g>

  <!-- Toilet -->
  <rect x="190" y="168" width="54" height="36" rx="4" fill="var(--part-1-tint)" stroke="var(--ink)" stroke-width="2.5"/>
  <path d="M184 210 H248 Q248 246 222 252 L226 288 H202 L206 252 Q184 246 184 210 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <path d="M190 216 H242" stroke="var(--ink)" stroke-width="2.5"/>
  <use href="#c1p6-ok" x="244" y="168"/>
  <use href="#c1p6-no" x="184" y="238"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="136" cy="186" r="14" fill="var(--accent)"/>
    <text x="136" y="192" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">4</text>
    <text x="154" y="192" font-size="16" font-weight="700" text-anchor="start">Tank</text>
    <text x="166" y="272" font-size="16" font-weight="700" text-anchor="end">Bowl</text>
  </g>

  <!-- ===== Upstairs right: bedroom ===== -->
  <!-- Radiator -->
  <g stroke="var(--ink)" stroke-width="2.5">
    <rect x="410" y="150" width="78" height="46" rx="5" fill="var(--card-2)"/>
    <path d="M424 156 V190 M438 156 V190 M452 156 V190 M466 156 V190 M480 156 V190"/>
  </g>
  <path d="M480 196 V454" stroke="var(--part-4)" stroke-width="5" stroke-dasharray="10 6"/>
  <use href="#c1p6-no" x="488" y="150"/>
  <text x="400" y="180" font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)" text-anchor="end">Radiator</text>
  <!-- Waterbed -->
  <rect x="468" y="214" width="12" height="62" rx="3" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5"/>
  <rect x="270" y="244" width="198" height="30" rx="8" fill="var(--part-1)" fill-opacity=".35" stroke="var(--ink)" stroke-width="2.5"/>
  <path d="M282 258 q12 -7 24 0 t24 0 t24 0 t24 0 t24 0 t24 0 t24 0" fill="none" stroke="var(--part-1-ink)" stroke-width="2.5"/>
  <path d="M276 274 V288 M462 274 V288" stroke="var(--ink)" stroke-width="3.5"/>
  <use href="#c1p6-no" x="276" y="234"/>
  <text x="294" y="232" font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)">Waterbed</text>

  <!-- ===== Downstairs left: kitchen ===== -->
  <!-- Cans on a shelf -->
  <path d="M46 344 H160" stroke="var(--ink)" stroke-width="4" stroke-linecap="round"/>
  <g stroke="var(--ink)" stroke-width="2.5">
    <rect x="52" y="312" width="28" height="32" rx="3" fill="var(--part-2-tint)"/>
    <rect x="88" y="312" width="28" height="32" rx="3" fill="var(--part-3-tint)"/>
    <rect x="124" y="312" width="28" height="32" rx="3" fill="var(--part-2-tint)"/>
    <path d="M52 320 H80 M88 320 H116 M124 320 H152 M52 336 H80 M88 336 H116 M124 336 H152" stroke-width="1.5"/>
  </g>
  <use href="#c1p6-ok" x="152" y="312"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="52" cy="368" r="14" fill="var(--accent)"/>
    <text x="52" y="374" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">5</text>
    <text x="70" y="374" font-size="16" font-weight="700">Can liquid</text>
  </g>

  <!-- Fridge-freezer with ice -->
  <rect x="180" y="300" width="62" height="154" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
  <path d="M180 352 H242 M232 316 V340 M232 362 V392" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
  <g fill="var(--part-7-tint)" stroke="var(--part-1-ink)" stroke-width="2">
    <rect x="188" y="310" width="14" height="14" rx="2"/><rect x="206" y="310" width="14" height="14" rx="2"/>
    <rect x="188" y="328" width="14" height="14" rx="2"/><rect x="206" y="328" width="14" height="14" rx="2"/>
  </g>
  <use href="#c1p6-ok" x="242" y="300"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="140" cy="404" r="14" fill="var(--accent)"/>
    <text x="140" y="410" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">3</text>
    <text x="172" y="414" font-size="16" font-weight="700" text-anchor="end" opacity="0"> </text>
    <text x="100" y="432" font-size="16" font-weight="700">Ice: melt it</text>
    <path d="M150 394 L180 344" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"/>
  </g>

  <!-- Lowest tap + pot -->
  <path d="M24 410 H50 V418" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M50 424 V430" stroke="var(--part-1)" stroke-width="3" stroke-linecap="round"/>
  <path d="M34 432 H70 L66 454 H38 Z" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <text x="78" y="452" font-size="15" font-weight="700" opacity="0"> </text>
  </g>

  <!-- ===== Downstairs right: utility ===== -->
  <!-- Water heater -->
  <path d="M276 288 V322 M312 288 V322" stroke="var(--ink)" stroke-width="5"/>
  <path d="M276 288 V322" stroke="var(--part-1)" stroke-width="2.5"/>
  <path d="M312 288 V322" stroke="var(--part-4)" stroke-width="2.5"/>
  <path d="M268 298 H284 L276 306 Z M268 314 H284 L276 306 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
  <rect x="262" y="322" width="64" height="116" rx="14" fill="#B9C2CA" stroke="var(--ink)" stroke-width="3"/>
  <path d="M270 438 V452 M318 438 V452" stroke="var(--ink)" stroke-width="4"/>
  <path d="M326 426 H340 V432" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linejoin="round"/>
  <use href="#c1p6-ok" x="326" y="324"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="352" cy="352" r="14" fill="var(--accent)"/>
    <text x="352" y="358" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">1</text>
    <text x="372" y="358" font-size="16" font-weight="700">Water heater</text>
    <text x="340" y="380" font-size="15">for taps, not heating</text>
  </g>
  <!-- Heating boiler -->
  <rect x="420" y="394" width="66" height="58" rx="5" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5"/>
  <path d="M446 438 c-8 0 -10 -10 -4 -16 c1 4 3 5 5 5 c-2 -6 2 -10 6 -12 c-1 6 6 8 6 15 c0 6 -5 8 -13 8z" fill="var(--part-3)" stroke="var(--ink)" stroke-width="1.5"/>
  <use href="#c1p6-no" x="486" y="394"/>
  <text x="412" y="424" font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)" text-anchor="end">Heating</text>
  <text x="412" y="444" font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)" text-anchor="end">boiler</text>

  <!-- ===== Yard: pool / spa ===== -->
  <path d="M300 466 H508 V532 H300 Z" fill="var(--part-1)" fill-opacity=".4" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round"/>
  <path d="M312 486 q14 -7 28 0 t28 0 t28 0 t28 0 t28 0 t28 0 t28 0" fill="none" stroke="var(--part-1-ink)" stroke-width="2.5"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <path d="M30 470 L46 498 H14 Z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <text x="30" y="494" text-anchor="middle" font-size="16" font-weight="700" fill="var(--warn-ink)">!</text>
    <text x="56" y="490" font-size="17" font-weight="700">Pool / spa</text>
    <text x="56" y="512" font-size="16">washing only —</text>
    <text x="56" y="532" font-size="16" font-weight="700">not for drinking</text>
  </g>

  <!-- ===== Strip: draining the water heater ===== -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="22" cy="574" r="14" fill="var(--accent)"/>
    <text x="22" y="580" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">1</text>
    <text x="44" y="582" font-family="var(--font-head)" font-weight="700" font-size="22">Drain the water heater</text>
  </g>
  <g font-family="var(--font-body)" fill="var(--ink)" font-size="16" text-anchor="middle">
    <!-- Panel a: power / gas off -->
    <g transform="translate(6 596)">
      <rect width="122" height="132" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <circle cx="16" cy="16" r="11" fill="var(--ink)"/><text x="16" y="21" font-size="15" font-weight="700" fill="var(--paper)">1</text>
      <path d="M44 74 c-10 0 -13 -13 -6 -20 c1 5 4 6 6 6 c-2 -8 2 -13 8 -15 c-1 8 7 10 7 19 c0 7 -6 10 -15 10z" fill="var(--part-3)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
      <path d="M88 32 L74 56 H86 L78 78 L98 50 H86 L94 32 Z" fill="var(--part-6)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
      <path d="M28 40 L60 80 M70 32 L104 80" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round"/>
      <text x="61" y="104" font-weight="700">Power or</text>
      <text x="61" y="124" font-weight="700">gas OFF</text>
    </g>
    <!-- Panel b: close cold inlet -->
    <g transform="translate(134 596)">
      <rect width="122" height="132" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <circle cx="16" cy="16" r="11" fill="var(--ink)"/><text x="16" y="21" font-size="15" font-weight="700" fill="var(--paper)">2</text>
      <path d="M61 24 V86" stroke="var(--ink)" stroke-width="12"/>
      <path d="M61 24 V86" stroke="var(--part-1)" stroke-width="6"/>
      <path d="M47 44 H75 L61 56 Z M47 68 H75 L61 56 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M61 56 H92" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
      <path d="M96 38 A22 22 0 0 1 100 70" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M93 66 L100 72 L104 63" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <text x="61" y="104" font-weight="700">Close the</text>
      <text x="61" y="124" font-weight="700">cold inlet</text>
    </g>
    <!-- Panel c: open a hot tap -->
    <g transform="translate(262 596)">
      <rect width="122" height="132" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <circle cx="16" cy="16" r="11" fill="var(--ink)"/><text x="16" y="21" font-size="15" font-weight="700" fill="var(--paper)">3</text>
      <path d="M30 40 H74 Q86 40 86 52 V58" fill="none" stroke="var(--ink)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M52 40 V28 M42 26 H62" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
      <circle cx="52" cy="22" r="0" />
      <rect x="40" y="18" width="24" height="10" rx="4" fill="var(--part-4)" stroke="var(--ink)" stroke-width="2"/>
      <path d="M86 66 q-6 9 0 12 q6 -3 0 -12 Z M86 82 V88" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2"/>
      <text x="61" y="104" font-weight="700">Open a</text>
      <text x="61" y="124" font-weight="700">hot tap</text>
    </g>
    <!-- Panel d: drain at the bottom -->
    <g transform="translate(390 596)">
      <rect width="124" height="132" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <circle cx="16" cy="16" r="11" fill="var(--ink)"/><text x="16" y="21" font-size="15" font-weight="700" fill="var(--paper)">4</text>
      <rect x="30" y="10" width="44" height="58" rx="10" fill="#B9C2CA" stroke="var(--ink)" stroke-width="2.5"/>
      <path d="M74 58 H86 V62" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linejoin="round"/>
      <path d="M86 66 V74" stroke="var(--part-1)" stroke-width="3" stroke-linecap="round"/>
      <path d="M70 76 H104 L100 90 H74 Z" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
      <text x="62" y="110" font-weight="700">Drain at</text>
      <text x="62" y="128" font-weight="700">the bottom</text>
    </g>
  </g>

  <!-- ===== Notes ===== -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <path d="M22 746 L38 774 H6 Z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <text x="22" y="770" text-anchor="middle" font-size="16" font-weight="700" fill="var(--warn-ink)">!</text>
    <text x="48" y="764" font-size="16"><tspan font-weight="700">4 Toilet TANK</tspan> only if clear and</text>
    <text x="48" y="786" font-size="16">no cleaner was added. <tspan font-weight="700">Treat it before drinking.</tspan></text>
    <text x="48" y="810" font-size="16"><tspan font-weight="700">2 Pipes:</tspan> open the highest tap, collect at the lowest.</text>
  </g>
</svg>
