---
// 1.6 main visual: house cut-away showing safe (✓) and unsafe (✕) water already inside the home.
---
<svg class="diagram" viewBox="0 0 520 884" role="img" aria-labelledby="c1p6-t c1p6-d">
  <title id="c1p6-t">Hidden water already in your home</title>
  <desc id="c1p6-d">A two-floor house cut open. Safe sources, marked with a check: 1, the water heater (the tank for your taps, not the heating system); 2, the water in the pipes: open the highest tap to let air in, then collect from the lowest tap; 3, melted ice cubes; 4, the toilet tank, not the bowl, only if it is clear and no cleaner was added, and treat it before drinking; 5, the liquid in canned fruit and vegetables. Never drink, marked with a cross: the toilet bowl, radiators and the heating boiler, and a waterbed. A pool or spa, marked with a warning triangle, is for washing only, not for drinking. To drain the water heater: turn the power or gas off, close the cold water inlet, open a hot tap, then drain from the valve at the bottom.</desc>
  <defs>
    <g id="c1p6-ok">
      <circle r="12" fill="var(--ok)" stroke="var(--card)" stroke-width="2"/>
      <path d="M-5.5 0.5 L-1.5 4.5 L5.5 -4" fill="none" stroke="var(--card)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    <g id="c1p6-no">
      <rect x="-11" y="-11" width="22" height="22" rx="3" fill="var(--no)" stroke="var(--card)" stroke-width="2"/>
      <path d="M-5 -5 L5 5 M5 -5 L-5 5" stroke="var(--card)" stroke-width="3" stroke-linecap="round"/>
    </g>
  </defs>

  <!-- ===== House shell ===== -->
  <path d="M2 106 L260 14 L518 106 Z" fill="var(--card-2)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"/>
  <rect x="10" y="106" width="500" height="374" fill="var(--card)" stroke="var(--ink)" stroke-width="3.5"/>
  <path d="M10 294 H510" stroke="var(--ink)" stroke-width="6"/>
  <path d="M252 106 V480" stroke="var(--ink)" stroke-width="3"/>
  <!-- Key in the roof -->
  <g font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)">
    <use href="#c1p6-ok" x="112" y="84"/><text x="130" y="90">Use</text>
    <use href="#c1p6-no" x="188" y="84"/><text x="206" y="90">Never drink</text>
    <path d="M326 72 L340 96 H312 Z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
    <text x="326" y="93" text-anchor="middle" font-size="14" fill="var(--warn-ink)" aria-hidden="true">!</text>
    <text x="346" y="90">Wash only</text>
  </g>
  <!-- Ground + yard -->
  <rect x="0" y="480" width="520" height="92" fill="var(--part-3-tint)"/>
  <path d="M0 480 H520" stroke="var(--ink)" stroke-width="3.5"/>

  <!-- ===== Supply pipe (blue) from the highest tap down to the lowest tap ===== -->
  <path d="M24 206 V436" stroke="var(--part-1)" stroke-width="6" stroke-linecap="round"/>

  <!-- ===== Upstairs left: bathroom ===== -->
  <!-- Sink + highest tap -->
  <path d="M24 206 H58 V216" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M38 222 H98 Q96 240 68 240 Q40 240 38 222 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <rect x="61" y="240" width="14" height="54" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
  <!-- air arrow into the tap -->
  <path d="M84 180 Q66 184 62 202" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M56 196 L62 206 L68 197" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="34" cy="138" r="14" fill="var(--accent)"/>
    <text x="34" y="145" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">2</text>
    <text x="54" y="144" font-size="16" font-weight="700">Highest tap</text>
    <text x="90" y="172" font-size="15">open: air in</text>
  </g>

  <!-- Toilet -->
  <rect x="190" y="186" width="54" height="36" rx="4" fill="var(--part-1-tint)" stroke="var(--ink)" stroke-width="2.5"/>
  <path d="M184 228 H248 Q248 264 222 270 L226 294 H202 L206 270 Q184 264 184 228 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <path d="M190 234 H242" stroke="var(--ink)" stroke-width="2.5"/>
  <use href="#c1p6-ok" x="244" y="186"/>
  <use href="#c1p6-no" x="184" y="256"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="132" cy="206" r="14" fill="var(--accent)"/>
    <text x="132" y="213" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">4</text>
    <text x="150" y="212" font-size="16" font-weight="700">Tank</text>
    <text x="166" y="262" font-size="16" font-weight="700" text-anchor="end">Bowl</text>
  </g>

  <!-- ===== Upstairs right: bedroom ===== -->
  <!-- Radiator -->
  <g stroke="var(--ink)" stroke-width="2.5">
    <rect x="410" y="140" width="78" height="46" rx="5" fill="var(--card-2)"/>
    <path d="M424 146 V180 M438 146 V180 M452 146 V180 M466 146 V180 M480 146 V180"/>
  </g>
  <path d="M480 186 V480" stroke="var(--part-4)" stroke-width="5" stroke-dasharray="10 6"/>
  <use href="#c1p6-no" x="488" y="140"/>
  <text x="400" y="170" font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)" text-anchor="end">Radiator</text>
  <!-- Waterbed -->
  <rect x="468" y="222" width="12" height="62" rx="3" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5"/>
  <rect x="270" y="252" width="198" height="30" rx="8" fill="var(--part-1)" fill-opacity=".35" stroke="var(--ink)" stroke-width="2.5"/>
  <path d="M282 266 q12 -7 24 0 t24 0 t24 0 t24 0 t24 0 t24 0 t24 0" fill="none" stroke="var(--part-1-ink)" stroke-width="2.5"/>
  <path d="M276 282 V294 M462 282 V294" stroke="var(--ink)" stroke-width="3.5"/>
  <use href="#c1p6-no" x="276" y="242"/>
  <text x="294" y="240" font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)">Waterbed</text>

  <!-- ===== Downstairs left: kitchen ===== -->
  <!-- Cans on a shelf -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="40" cy="322" r="14" fill="var(--accent)"/>
    <text x="40" y="329" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">5</text>
    <text x="60" y="328" font-size="16" font-weight="700">Can liquid</text>
  </g>
  <path d="M46 384 H160" stroke="var(--ink)" stroke-width="4" stroke-linecap="round"/>
  <g stroke="var(--ink)" stroke-width="2.5">
    <rect x="52" y="352" width="28" height="32" rx="3" fill="var(--part-2-tint)"/>
    <rect x="88" y="352" width="28" height="32" rx="3" fill="var(--part-3-tint)"/>
    <rect x="124" y="352" width="28" height="32" rx="3" fill="var(--part-2-tint)"/>
    <path d="M52 360 H80 M88 360 H116 M124 360 H152 M52 376 H80 M88 376 H116 M124 376 H152" stroke-width="1.5"/>
  </g>
  <use href="#c1p6-ok" x="152" y="352"/>

  <!-- Fridge-freezer with ice -->
  <rect x="178" y="306" width="66" height="174" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
  <path d="M178 362 H244 M236 322 V346 M236 372 V396" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
  <g fill="var(--part-7-tint)" stroke="var(--part-1-ink)" stroke-width="2">
    <rect x="188" y="318" width="15" height="15" rx="2"/><rect x="207" y="318" width="15" height="15" rx="2"/>
    <rect x="188" y="337" width="15" height="15" rx="2"/><rect x="207" y="337" width="15" height="15" rx="2"/>
  </g>
  <use href="#c1p6-ok" x="244" y="306"/>
  <g font-family="var(--font-body)" fill="var(--ink)" text-anchor="middle">
    <circle cx="208" cy="400" r="14" fill="var(--accent)"/>
    <text x="208" y="407" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">3</text>
    <text x="210" y="436" font-size="16" font-weight="700">Ice:</text>
    <text x="210" y="456" font-size="15" font-weight="700">melt it</text>
  </g>

  <!-- Lowest tap + pot -->
  <path d="M24 436 H50 V444" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M50 450 V456" stroke="var(--part-1)" stroke-width="3" stroke-linecap="round"/>
  <path d="M34 458 H70 L66 480 H38 Z" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="96" cy="412" r="14" fill="var(--accent)"/>
    <text x="96" y="419" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">2</text>
    <text x="80" y="448" font-size="16" font-weight="700">Lowest tap</text>
    <text x="80" y="468" font-size="15">collect here</text>
  </g>

  <!-- ===== Downstairs right: utility ===== -->
  <!-- Water heater -->
  <path d="M276 294 V340 M312 294 V340" stroke="var(--ink)" stroke-width="5"/>
  <path d="M276 294 V340" stroke="var(--part-1)" stroke-width="2.5"/>
  <path d="M312 294 V340" stroke="var(--part-4)" stroke-width="2.5"/>
  <path d="M268 306 H284 L276 314 Z M268 322 H284 L276 314 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
  <rect x="262" y="340" width="64" height="124" rx="14" fill="#B9C2CA" stroke="var(--ink)" stroke-width="3"/>
  <path d="M270 464 V478 M318 464 V478" stroke="var(--ink)" stroke-width="4"/>
  <path d="M326 450 H340 V456" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linejoin="round"/>
  <use href="#c1p6-ok" x="326" y="342"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="352" cy="372" r="14" fill="var(--accent)"/>
    <text x="352" y="379" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">1</text>
    <text x="372" y="378" font-size="16" font-weight="700">Water heater</text>
    <text x="340" y="400" font-size="15">for taps, not heating</text>
  </g>
  <!-- Heating boiler -->
  <rect x="420" y="414" width="66" height="64" rx="5" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5"/>
  <path d="M446 464 c-8 0 -10 -10 -4 -16 c1 4 3 5 5 5 c-2 -6 2 -10 6 -12 c-1 6 6 8 6 15 c0 6 -5 8 -13 8z" fill="var(--part-3)" stroke="var(--ink)" stroke-width="1.5"/>
  <use href="#c1p6-no" x="486" y="414"/>
  <text x="412" y="446" font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)" text-anchor="end">Heating</text>
  <text x="412" y="466" font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)" text-anchor="end">boiler</text>

  <!-- ===== Yard: pool / spa ===== -->
  <path d="M300 494 H508 V560 H300 Z" fill="var(--part-1)" fill-opacity=".4" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round"/>
  <path d="M312 514 q14 -7 28 0 t28 0 t28 0 t28 0 t28 0 t28 0 t28 0" fill="none" stroke="var(--part-1-ink)" stroke-width="2.5"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <path d="M30 498 L46 526 H14 Z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <text x="30" y="522" text-anchor="middle" font-size="16" font-weight="700" fill="var(--warn-ink)">!</text>
    <text x="56" y="516" font-size="17" font-weight="700">Pool / spa</text>
    <text x="56" y="538" font-size="16">washing only —</text>
    <text x="56" y="558" font-size="16" font-weight="700">not for drinking</text>
  </g>

  <!-- ===== Strip: draining the water heater ===== -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <circle cx="22" cy="602" r="14" fill="var(--accent)"/>
    <text x="22" y="608" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">1</text>
    <text x="44" y="610" font-family="var(--font-head)" font-weight="700" font-size="22">Drain the water heater</text>
  </g>
  <g font-family="var(--font-body)" fill="var(--ink)" font-size="16" text-anchor="middle">
    <!-- Panel a: power / gas off -->
    <g transform="translate(6 624)">
      <rect width="122" height="132" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <circle cx="16" cy="16" r="11" fill="var(--ink)"/><text x="16" y="21" font-size="15" font-weight="700" fill="var(--paper)">1</text>
      <path d="M44 74 c-10 0 -13 -13 -6 -20 c1 5 4 6 6 6 c-2 -8 2 -13 8 -15 c-1 8 7 10 7 19 c0 7 -6 10 -15 10z" fill="var(--part-3)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
      <path d="M88 32 L74 56 H86 L78 78 L98 50 H86 L94 32 Z" fill="var(--part-6)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
      <path d="M28 40 L60 80 M70 32 L104 80" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round"/>
      <text x="61" y="104" font-weight="700">Power or</text>
      <text x="61" y="124" font-weight="700">gas OFF</text>
    </g>
    <!-- Panel b: close cold inlet -->
    <g transform="translate(134 624)">
      <rect width="122" height="132" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <circle cx="16" cy="16" r="11" fill="var(--ink)"/><text x="16" y="21" font-size="15" font-weight="700" fill="var(--paper)">2</text>
      <path d="M61 24 V86" stroke="var(--ink)" stroke-width="12"/>
      <path d="M61 24 V86" stroke="var(--part-1)" stroke-width="6"/>
      <path d="M47 44 H75 L61 56 Z M47 68 H75 L61 56 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M61 56 H92" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
      <path d="M96 38 A22 22 0 0 1 100 70" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M93 66 L100 72 L104 63" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <text x="61" y="104" font-weight="700">Close the</text>
      <text x="61" y="124" font-weight="700">cold inlet</text>
    </g>
    <!-- Panel c: open a hot tap -->
    <g transform="translate(262 624)">
      <rect width="122" height="132" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <circle cx="16" cy="16" r="11" fill="var(--ink)"/><text x="16" y="21" font-size="15" font-weight="700" fill="var(--paper)">3</text>
      <path d="M30 40 H74 Q86 40 86 52 V58" fill="none" stroke="var(--ink)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M52 40 V28 M42 26 H62" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
            <rect x="40" y="18" width="24" height="10" rx="4" fill="var(--part-4)" stroke="var(--ink)" stroke-width="2"/>
      <path d="M86 66 q-6 9 0 12 q6 -3 0 -12 Z M86 82 V88" fill="var(--part-1)" stroke="var(--ink)" stroke-width="2"/>
      <text x="61" y="104" font-weight="700">Open a</text>
      <text x="61" y="124" font-weight="700">hot tap</text>
    </g>
    <!-- Panel d: drain at the bottom -->
    <g transform="translate(390 624)">
      <rect width="124" height="132" rx="10" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
      <circle cx="16" cy="16" r="11" fill="var(--ink)"/><text x="16" y="21" font-size="15" font-weight="700" fill="var(--paper)">4</text>
      <rect x="30" y="8" width="44" height="52" rx="10" fill="#B9C2CA" stroke="var(--ink)" stroke-width="2.5"/>
      <path d="M74 52 H86 V56" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linejoin="round"/>
      <path d="M86 60 V68" stroke="var(--part-1)" stroke-width="3" stroke-linecap="round"/>
      <path d="M68 70 H104 L100 86 H72 Z" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
      <text x="62" y="104" font-weight="700">Drain at</text>
      <text x="62" y="124" font-weight="700">the bottom</text>
    </g>
  </g>

  <!-- ===== Notes ===== -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <path d="M22 778 L38 806 H6 Z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <text x="22" y="802" text-anchor="middle" font-size="16" font-weight="700" fill="var(--warn-ink)">!</text>
    <text x="48" y="792" font-size="16"><tspan font-weight="700">Toilet tank (4):</tspan> only if clear and</text>
    <text x="48" y="814" font-size="16">no cleaner was added. <tspan font-weight="700">Treat before drinking.</tspan></text>
    <circle cx="22" cy="846" r="14" fill="var(--accent)"/>
    <text x="22" y="853" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="19" fill="var(--on-accent)">2</text>
    <text x="48" y="846" font-size="16"><tspan font-weight="700">Pipes:</tspan> open the highest tap to let air in,</text>
    <text x="48" y="868" font-size="16">then collect from the lowest tap.</text>
  </g>
</svg>
