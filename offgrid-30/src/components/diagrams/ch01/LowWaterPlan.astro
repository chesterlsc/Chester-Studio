---
// 1.9 main visual: what to do, in order, when water runs low.
---
<svg class="diagram" viewBox="0 0 520 880" role="img" aria-labelledby="c1p9-t c1p9-d">
  <title id="c1p9-t">When water runs low: 5 steps in order</title>
  <desc id="c1p9-d">Five steps, top to bottom. 1: Drink what you need today. Rule: never less than 1 quart a day, that is 4 cups or about 1 litre. 2: Drink the water you know is safe first. 3: Use untreated water only for laundry and bathing, not for drinking, hands, dishes, food or teeth. 4: Save body water: stay in the shade from 11 am to 3 pm, rest, eat no salty food, skip alcohol, go easy on caffeine (plain water is best), and eat canned food with a lot of liquid. 5: Find more water for tomorrow.</desc>
  <defs>
    <g id="c1p9-cup">
      <path d="M-11 -14 H11 L8 14 H-8 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M-9.5 -4 H9.5 L8 14 H-8 Z" fill="var(--part-1)" fill-opacity=".55"/>
    </g>
    <g id="c1p9-no">
      <rect x="-10" y="-10" width="20" height="20" rx="3" fill="var(--no)" stroke="var(--card)" stroke-width="2"/>
      <path d="M-4.5 -4.5 L4.5 4.5 M4.5 -4.5 L-4.5 4.5" stroke="var(--card)" stroke-width="3" stroke-linecap="round"/>
    </g>
    <g id="c1p9-ok">
      <circle r="11" fill="var(--ok)" stroke="var(--card)" stroke-width="2"/>
      <path d="M-5 0.5 L-1.5 4 L5 -3.5" fill="none" stroke="var(--card)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
  </defs>

  <!-- Spine -->
  <path d="M30 40 V830" stroke="var(--accent)" stroke-width="5" stroke-linecap="round"/>
  <path d="M30 842 L20 826 H40 Z" fill="var(--accent)"/>

  <g font-family="var(--font-body)" fill="var(--ink)">

    <!-- ===== 1 ===== -->
    <rect x="58" y="12" width="456" height="196" rx="12" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <use href="#c1p9-cup" x="98" y="58"/>
    <text x="134" y="52" font-size="20" font-weight="700">Drink what you</text>
    <text x="134" y="76" font-size="20" font-weight="700">need today</text>
    <!-- Rule band -->
    <rect x="70" y="96" width="432" height="100" rx="10" fill="var(--part-6-tint)" stroke="var(--ink)" stroke-width="3"/>
    <path d="M100 108 L122 146 H78 Z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <text x="100" y="141" text-anchor="middle" font-size="20" font-weight="700" fill="var(--warn-ink)">!</text>
    <text x="134" y="124" font-size="19" font-weight="700">NEVER less than</text>
    <text x="134" y="148" font-size="19" font-weight="700">1 quart a day</text>
    <text x="134" y="176" font-size="16">= 4 cups, about 1 L</text>
    <use href="#c1p9-cup" x="318" y="146"/><use href="#c1p9-cup" x="352" y="146"/><use href="#c1p9-cup" x="386" y="146"/><use href="#c1p9-cup" x="420" y="146"/>
    <text x="446" y="152" font-size="20" font-weight="700">=</text>
    <text x="482" y="142" font-size="17" font-weight="700" text-anchor="middle">1 qt</text>
    <text x="482" y="162" font-size="15" text-anchor="middle">~1 L</text>

    <!-- ===== 2 ===== -->
    <rect x="58" y="232" width="456" height="96" rx="12" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <g transform="translate(98 280)">
      <path d="M-6 -36 H6 V-28 Q16 -24 16 -14 V30 Q16 34 12 34 H-12 Q-16 34 -16 30 V-14 Q-16 -24 -6 -28 Z" fill="var(--part-1-tint)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
      <rect x="-8" y="-40" width="16" height="7" rx="2" fill="var(--ink)"/>
      <path d="M-16 0 H16 V26 H-16 Z" fill="var(--part-1)" fill-opacity=".5"/>
    </g>
    <use href="#c1p9-ok" x="116" y="256"/>
    <text x="140" y="272" font-size="20" font-weight="700">Drink water you know</text>
    <text x="140" y="296" font-size="20" font-weight="700">is safe first</text>
    <text x="140" y="318" font-size="16" fill="var(--ink-2)">Like sealed bottled water</text>

    <!-- ===== 3 ===== -->
    <rect x="58" y="352" width="456" height="112" rx="12" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <!-- bucket of untreated water -->
    <g transform="translate(96 410)">
      <path d="M-22 -20 H22 L17 26 H-17 Z" fill="var(--card-2)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M-20.5 -6 H20.5 L17 26 H-17 Z" fill="var(--part-3-ink)" fill-opacity=".45"/>
      <path d="M-22 -20 Q0 -46 22 -20" fill="none" stroke="var(--ink)" stroke-width="2.5"/>
      <text y="16" text-anchor="middle" font-size="20" font-weight="700">?</text>
    </g>
    <text x="140" y="386" font-size="20" font-weight="700">Untreated water:</text>
    <text x="140" y="410" font-size="20" font-weight="700">laundry &amp; bathing only</text>
    <!-- shirt = laundry ok ; cup = no drinking, hands or dishes -->
    <g transform="translate(150 438)">
      <path d="M-14 -12 L-6 -16 Q0 -10 6 -16 L14 -12 L18 -2 L11 0 V14 H-11 V0 L-18 -2 Z" fill="var(--part-7-tint)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
    </g>
    <use href="#c1p9-ok" x="176" y="428"/>
    <text x="194" y="446" font-size="16">laundry</text>
    <use href="#c1p9-cup" x="262" y="438"/>
    <use href="#c1p9-no" x="284" y="428"/>
    <text x="302" y="446" font-size="16" font-weight="700">drinking, hands, dishes</text>

    <!-- ===== 4 ===== -->
    <rect x="58" y="488" width="456" height="230" rx="12" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="80" y="522" font-size="20" font-weight="700">Save body water</text>
    <g font-size="15" text-anchor="middle">
      <!-- shade -->
      <g transform="translate(104 590)">
        <circle cx="16" cy="-34" r="11" fill="var(--part-3)" stroke="var(--ink)" stroke-width="2"/>
        <path d="M-26 -10 Q-8 -40 18 -10 Z" fill="var(--part-2)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
        <path d="M-4 -12 V26" stroke="var(--ink)" stroke-width="4"/>
        <circle cx="-16" cy="6" r="5" fill="var(--card)" stroke="var(--ink)" stroke-width="2"/>
        <path d="M-16 11 V24" stroke="var(--ink)" stroke-width="3"/>
      </g>
      <text x="104" y="644" font-weight="700">Shade</text>
      <text x="104" y="664">11 am–3 pm</text>
      <!-- rest -->
      <g transform="translate(192 594)">
        <rect x="-32" y="-2" width="64" height="12" rx="3" fill="var(--part-7-tint)" stroke="var(--ink)" stroke-width="2.5"/>
        <path d="M-32 10 V24 M32 10 V24 M-32 -16 V10" stroke="var(--ink)" stroke-width="3"/>
        <circle cx="-20" cy="-8" r="6" fill="var(--card)" stroke="var(--ink)" stroke-width="2"/>
        <path d="M0 -36 H10 L0 -26 H10 M16 -48 H24 L16 -40 H24" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
      </g>
      <text x="192" y="644" font-weight="700">Rest</text>
      <!-- salt -->
      <g transform="translate(278 592)">
        <path d="M-12 -18 Q-12 -30 0 -30 Q12 -30 12 -18 V22 H-12 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
        <circle cx="-4" cy="-24" r="1.6" fill="var(--ink)"/><circle cx="4" cy="-24" r="1.6" fill="var(--ink)"/><circle cx="0" cy="-19" r="1.6" fill="var(--ink)"/>
        <text y="12" font-size="15" font-weight="700">S</text>
      </g>
      <use href="#c1p9-no" x="298" y="570"/>
      <text x="278" y="644" font-weight="700">No salty</text>
      <text x="278" y="664">food</text>
      <!-- alcohol / caffeine -->
      <g transform="translate(364 592)">
        <path d="M-20 -10 H6 V16 Q6 22 0 22 H-14 Q-20 22 -20 16 Z" fill="var(--part-3-ink)" fill-opacity=".55" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
        <path d="M6 -4 Q16 -4 16 4 Q16 12 6 12" fill="none" stroke="var(--ink)" stroke-width="2.5"/>
        <path d="M-12 -16 q-4 -6 0 -12 M-2 -16 q-4 -6 0 -12" fill="none" stroke="var(--ink-2)" stroke-width="2" stroke-linecap="round"/>
      </g>
      <use href="#c1p9-no" x="386" y="570"/>
      <text x="364" y="644" font-weight="700">No alcohol</text>
      <text x="364" y="664">less caffeine</text>
      <!-- canned food -->
      <g transform="translate(462 592)">
        <rect x="-16" y="-22" width="32" height="44" rx="4" fill="var(--part-2-tint)" stroke="var(--ink)" stroke-width="2.5"/>
        <path d="M-16 -12 H16 M-16 12 H16" stroke="var(--ink)" stroke-width="1.5"/>
        <path d="M0 -6 q-6 9 0 12 q6 -3 0 -12 Z" fill="var(--part-1)" stroke="var(--ink)" stroke-width="1.5"/>
      </g>
      <use href="#c1p9-ok" x="482" y="570"/>
      <text x="462" y="644" font-weight="700">Watery</text>
      <text x="462" y="664">canned food</text>
    </g>
    <text x="80" y="700" font-size="16" fill="var(--ink-2)">Stay cool and do less: your body needs less.</text>

    <!-- ===== 5 ===== -->
    <rect x="58" y="742" width="456" height="98" rx="12" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <g transform="translate(98 796)">
      <circle r="20" fill="var(--card)" stroke="var(--ink)" stroke-width="3"/>
      <path d="M14 14 L28 28" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
      <path d="M0 -10 q-8 12 0 16 q8 -4 0 -16 Z" fill="var(--part-1)" stroke="var(--ink)" stroke-width="1.5"/>
    </g>
    <text x="140" y="786" font-size="20" font-weight="700">Find more water</text>
    <text x="140" y="810" font-size="20" font-weight="700">for tomorrow</text>
  </g>

  <!-- Step numbers on the spine -->
  <g font-family="var(--font-head)" font-weight="700" font-size="24" text-anchor="middle">
    <circle cx="30" cy="40" r="20" fill="var(--accent)" stroke="var(--paper)" stroke-width="3"/><text x="30" y="48" fill="var(--on-accent)">1</text>
    <circle cx="30" cy="268" r="20" fill="var(--accent)" stroke="var(--paper)" stroke-width="3"/><text x="30" y="276" fill="var(--on-accent)">2</text>
    <circle cx="30" cy="390" r="20" fill="var(--accent)" stroke="var(--paper)" stroke-width="3"/><text x="30" y="398" fill="var(--on-accent)">3</text>
    <circle cx="30" cy="514" r="20" fill="var(--accent)" stroke="var(--paper)" stroke-width="3"/><text x="30" y="522" fill="var(--on-accent)">4</text>
    <circle cx="30" cy="780" r="20" fill="var(--accent)" stroke="var(--paper)" stroke-width="3"/><text x="30" y="788" fill="var(--on-accent)">5</text>
  </g>
</svg>
