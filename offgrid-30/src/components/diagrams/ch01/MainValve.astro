---
// 1.7 main visual: where the main water line enters the house — house valve (use) vs street valve (don't) + winter outdoor-tap inset.
---
<svg class="diagram" viewBox="0 0 520 846" role="img" aria-labelledby="c1p7-t c1p7-d">
  <title id="c1p7-t">Find and test your home's main water valve</title>
  <desc id="c1p7-d">The water line comes from the street, under the ground, into the house. Inside the house, where the line comes through the wall, is the house main valve, marked with a check: use this one. Find it and hang a tag on it that says MAIN WATER. Test it now: it may be rusted open or only close part way. Shutting it traps water in your water heater and toilet tanks, and keeps dirty water out, because broken lines can pollute your water. Outside, the street or curb valve in a cement box, marked with a cross, needs a special tool. Winter inset: close the inside valve that feeds the outdoor tap, then open the outdoor tap so the pipe can drain.</desc>
  <defs>
    <g id="c1p7-ok">
      <circle r="14" fill="var(--ok)" stroke="var(--card)" stroke-width="2"/>
      <path d="M-6.5 0.5 L-2 5 L6.5 -4.5" fill="none" stroke="var(--card)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    <g id="c1p7-no">
      <rect x="-13" y="-13" width="26" height="26" rx="4" fill="var(--no)" stroke="var(--card)" stroke-width="2"/>
      <path d="M-6 -6 L6 6 M6 -6 L-6 6" stroke="var(--card)" stroke-width="3.5" stroke-linecap="round"/>
    </g>
  </defs>

  <!-- ===== Soil + ground ===== -->
  <rect x="0" y="230" width="520" height="232" fill="var(--part-3-tint)"/>
  <!-- House: ground floor + basement -->
  <path d="M220 70 L370 14 L520 70" fill="var(--card-2)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"/>
  <rect x="228" y="70" width="300" height="160" fill="var(--card)" stroke="var(--ink)" stroke-width="3.5"/>
  <rect x="234" y="230" width="290" height="190" fill="var(--card)"/>
  <rect x="222" y="230" width="12" height="190" fill="var(--card-2)" stroke="var(--ink)" stroke-width="3"/>
  <path d="M222 420 H520" stroke="var(--ink)" stroke-width="5"/>
  <path d="M0 230 H520" stroke="var(--ink)" stroke-width="3.5"/>
  <text x="244" y="408" font-family="var(--font-body)" font-size="15" font-weight="700" fill="var(--ink-2)">Basement</text>

  <!-- Street + curb -->
  <path d="M0 222 H150 V230" fill="none" stroke="var(--ink)" stroke-width="3"/>
  <rect x="0" y="222" width="150" height="8" fill="var(--rule-strong)"/>
  <text x="12" y="216" font-family="var(--font-body)" font-size="15" font-weight="700" fill="var(--ink-2)">Street</text>

  <!-- ===== Water line ===== -->
  <path d="M0 370 H296 V258 H484 V300 M412 258 V188" fill="none" stroke="var(--ink)" stroke-width="13" stroke-linejoin="round"/>
  <path d="M0 370 H296 V258 H484 V300 M412 258 V188" fill="none" stroke="var(--part-1)" stroke-width="7" stroke-linejoin="round"/>
  <!-- crack + dirt -->
  <path d="M58 361 L66 366 L60 372 L68 379 L78 379 L70 372 L76 366 L68 361 Z" fill="var(--part-3-tint)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <g fill="var(--part-3-ink)">
    <circle cx="56" cy="394" r="4"/><circle cx="74" cy="398" r="5"/><circle cx="66" cy="412" r="4"/><circle cx="84" cy="384" r="3.5"/><circle cx="48" cy="382" r="3"/>
  </g>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <text x="12" y="434" font-size="16"><tspan font-weight="700">Why:</tspan> broken lines can</text>
    <text x="12" y="454" font-size="16">pollute your water</text>
  </g>

  <!-- Curb box (street valve) -->
  <rect x="150" y="228" width="44" height="130" fill="var(--card-2)" stroke="var(--ink)" stroke-width="3.5"/>
  <rect x="146" y="224" width="52" height="10" rx="2" fill="var(--rule-strong)" stroke="var(--ink)" stroke-width="2.5"/>
  <path d="M164 370 L172 360 L180 370 L172 380 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <path d="M172 360 V246" stroke="var(--ink)" stroke-width="3" stroke-dasharray="5 4"/>
  <use href="#c1p7-no" x="198" y="226"/>
  <g font-family="var(--font-body)" fill="var(--ink)">
    <text x="12" y="104" font-size="18" font-weight="700">Street valve</text>
    <text x="12" y="126" font-size="16">in a cement box</text>
    <text x="12" y="150" font-size="16" font-weight="700">Needs a special tool</text>
    <path d="M150 158 L170 214" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="170" cy="214" r="4" fill="var(--ink)"/>
  </g>

  <!-- ===== House main valve ===== -->
  <path d="M284 300 H308 L296 312 Z M284 324 H308 L296 312 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <path d="M296 312 H264" stroke="var(--ink)" stroke-width="4" stroke-linecap="round"/>
  <g transform="translate(256 312)">
    <circle r="15" fill="var(--part-4)" stroke="var(--ink)" stroke-width="3"/>
    <path d="M-15 0 H15 M0 -15 V15" stroke="var(--ink)" stroke-width="2.5"/>
    <circle r="4" fill="var(--ink)"/>
  </g>
  <!-- tag -->
  <path d="M300 318 Q312 336 318 340" fill="none" stroke="var(--ink)" stroke-width="2"/>
  <g transform="rotate(6 318 340)">
    <path d="M318 338 H418 Q424 338 424 344 V366 Q424 372 418 372 H318 L308 355 Z" fill="var(--part-6)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <circle cx="320" cy="355" r="3" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5"/>
    <text x="370" y="361" text-anchor="middle" font-family="var(--font-head)" font-size="18" font-weight="700" fill="var(--on-part-6)">MAIN WATER</text>
  </g>
  <use href="#c1p7-ok" x="324" y="290"/>
  <text x="344" y="297" font-family="var(--font-body)" font-size="20" font-weight="700" fill="var(--ink)">Use this one</text>

  <!-- Water heater (basement) -->
  <rect x="456" y="300" width="56" height="112" rx="12" fill="#B9C2CA" stroke="var(--ink)" stroke-width="3"/>
  <text x="512" y="446" text-anchor="end" font-family="var(--font-body)" font-size="15" font-weight="700" fill="var(--ink)">Water heater</text>
  <!-- Toilet tank (ground floor) -->
  <rect x="388" y="150" width="50" height="36" rx="4" fill="var(--part-1-tint)" stroke="var(--ink)" stroke-width="2.5"/>
  <path d="M384 192 H442 Q442 216 418 222 L420 230 H404 L406 222 Q384 216 384 192 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
  <g font-family="var(--font-body)" fill="var(--ink)" font-size="15" font-weight="700">
    <text x="500" y="146" text-anchor="end">Toilet</text><text x="500" y="164" text-anchor="end">tank</text>
  </g>

  <!-- Step numbers on the drawing -->
  <g font-family="var(--font-head)" font-weight="700" font-size="20" text-anchor="middle">
    <circle cx="336" cy="398" r="15" fill="var(--accent)"/><text x="336" y="405" fill="var(--on-accent)">1</text>
    <circle cx="256" cy="276" r="15" fill="var(--accent)"/><text x="256" y="283" fill="var(--on-accent)">2</text>
    <circle cx="362" cy="214" r="15" fill="var(--accent)"/><text x="362" y="221" fill="var(--on-accent)">3</text>
  </g>

  <!-- ===== Callouts ===== -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <g font-family="var(--font-head)" font-weight="700" font-size="20" text-anchor="middle">
      <circle cx="26" cy="494" r="15" fill="var(--accent)"/><text x="26" y="501" fill="var(--on-accent)">1</text>
      <circle cx="26" cy="536" r="15" fill="var(--accent)"/><text x="26" y="543" fill="var(--on-accent)">2</text>
      <circle cx="26" cy="600" r="15" fill="var(--accent)"/><text x="26" y="607" fill="var(--on-accent)">3</text>
    </g>
    <text x="52" y="500" font-size="17"><tspan font-weight="700">Find it and tag it.</tspan> Show everyone at home.</text>
    <text x="52" y="542" font-size="17"><tspan font-weight="700">Test it now:</tspan> it may be rusted open</text>
    <text x="52" y="564" font-size="17">or only close part way.</text>
    <text x="52" y="606" font-size="17"><tspan font-weight="700">Shut it to trap water</tspan> in your heater</text>
    <text x="52" y="628" font-size="17">and toilet tanks.</text>
  </g>

  <!-- ===== Winter inset ===== -->
  <g transform="translate(8 648)" font-family="var(--font-body)" fill="var(--ink)">
    <rect width="504" height="190" rx="12" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="16" y="32" font-family="var(--font-head)" font-weight="700" font-size="23">Winter: outdoor tap</text>
    <!-- snowflake -->
    <g transform="translate(470 30)" stroke="var(--part-7-ink)" stroke-width="3" stroke-linecap="round">
      <path d="M0 -16 V16 M-14 -8 L14 8 M-14 8 L14 -8"/>
    </g>
    <!-- wall -->
    <rect x="300" y="48" width="26" height="130" fill="var(--card-2)" stroke="var(--ink)" stroke-width="3"/>
    <text x="150" y="70" text-anchor="middle" font-size="15" font-weight="700" fill="var(--ink-2)">INSIDE</text>
    <text x="410" y="70" text-anchor="middle" font-size="15" font-weight="700" fill="var(--ink-2)">OUTSIDE</text>
    <!-- pipe -->
    <path d="M20 106 H372 V118" fill="none" stroke="var(--ink)" stroke-width="12" stroke-linejoin="round"/>
    <path d="M20 106 H372 V118" fill="none" stroke="var(--part-1)" stroke-width="6" stroke-linejoin="round"/>
    <path d="M220 106 H366 V114" fill="none" stroke="var(--card)" stroke-width="6" stroke-linejoin="round"/>
    <!-- inside valve, closed (handle across the pipe) -->
    <path d="M188 94 V118 L212 94 V118 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <path d="M200 106 V84" stroke="var(--ink)" stroke-width="3"/>
    <rect x="184" y="76" width="32" height="10" rx="4" fill="var(--part-4)" stroke="var(--ink)" stroke-width="2"/>
    <!-- outside tap, open + drips -->
    <rect x="356" y="86" width="28" height="12" rx="4" fill="var(--part-4)" stroke="var(--ink)" stroke-width="2" transform="rotate(-35 370 92)"/>
    <path d="M372 92 V100" stroke="var(--ink)" stroke-width="3"/>
    <g fill="var(--part-1)" stroke="var(--ink)" stroke-width="1.5">
      <path d="M372 128 q-5 8 0 10 q5 -2 0 -10 Z"/><path d="M372 146 q-5 8 0 10 q5 -2 0 -10 Z"/>
    </g>
    <g font-family="var(--font-head)" font-weight="700" font-size="17" text-anchor="middle">
      <circle cx="30" cy="148" r="12" fill="var(--ink)"/><text x="30" y="154" fill="var(--paper)">1</text>
    </g>
    <text x="48" y="154" font-size="17" font-weight="700">Close the inside valve</text>
    <path d="M200 136 V122" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"/>
    <g font-family="var(--font-head)" font-weight="700" font-size="17" text-anchor="middle">
      <circle cx="404" cy="128" r="12" fill="var(--ink)"/><text x="404" y="134" fill="var(--paper)">2</text>
    </g>
    <text x="420" y="134" font-size="17" font-weight="700">Open it</text>
    <text x="392" y="158" font-size="16">to drain</text>
  </g>
</svg>
