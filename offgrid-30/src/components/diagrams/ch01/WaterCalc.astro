---
// 1.8 main visual: water budget calculator.
// Without JavaScript (and in print) only the static "Quick table" shows.
// Formula: people × days × 1 US gal (3.785 L) [× 2 in hot weather] + pets (dogs 73, cats 60 mL per kg per day).
const GAL_L = 3.785;
const PEOPLE = [1, 2, 3, 4, 5, 6];
const DAYS = [3, 14, 30];
const litres = (gal: number) => Math.round(gal * GAL_L).toLocaleString('en-US');
---
<section class="wc" data-water-calc aria-labelledby="c1p8-h">
  <header class="wc__head">
    <svg class="wc__headicon" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true" focusable="false">
      <path d="M17 6 H31 V12 Q40 15 40 24 V40 Q40 44 36 44 H12 Q8 44 8 40 V24 Q8 15 17 12 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round"/>
      <rect x="15" y="3" width="18" height="6" rx="2" fill="var(--ink)"/>
      <path d="M9.5 26 H38.5 V40 Q38.5 42.5 36 42.5 H12 Q9.5 42.5 9.5 40 Z" fill="var(--part-1)"/>
    </svg>
    <div>
      <p class="wc__kicker">Water budget</p>
      <h2 id="c1p8-h" class="wc__title">How much water to store</h2>
    </div>
  </header>

  <div class="wc__live no-print" data-live hidden>
    <form class="wc__form" data-form novalidate>
      <!-- People -->
      <div class="wc__field">
        <label class="wc__label" for="c1p8-people">People</label>
        <div class="wc__stepper">
          <button type="button" class="wc__stepbtn" data-step="-1" aria-label="One person fewer" aria-controls="c1p8-people">
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path d="M5 12 H19" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></svg>
          </button>
          <input class="wc__num" id="c1p8-people" name="people" type="number" inputmode="numeric" min="1" max="99" step="1" value="4" />
          <button type="button" class="wc__stepbtn" data-step="1" aria-label="One person more" aria-controls="c1p8-people">
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path d="M5 12 H19 M12 5 V19" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>

      <!-- Days -->
      <fieldset class="wc__field">
        <legend class="wc__label">Days</legend>
        <div class="wc__chips">
          <label class="wc__chip"><input type="radio" name="days" value="3" /><span>3</span></label>
          <label class="wc__chip"><input type="radio" name="days" value="14" checked /><span>14</span></label>
          <label class="wc__chip"><input type="radio" name="days" value="30" /><span>30</span></label>
          <label class="wc__chip"><input type="radio" name="days" value="custom" /><span>Other</span></label>
        </div>
        <div class="wc__custom" data-custom hidden>
          <label for="c1p8-days-n">Number of days</label>
          <input class="wc__num wc__num--sm" id="c1p8-days-n" name="customDays" type="number" inputmode="numeric" min="1" max="3650" step="1" value="60" />
        </div>
        <p class="wc__hint">3 days at least · aim for 14 (2 weeks)</p>
      </fieldset>

      <!-- Hot weather -->
      <div class="wc__field wc__hot">
        <input class="wc__switchinput" type="checkbox" id="c1p8-hot" name="hot" role="switch" />
        <label for="c1p8-hot" class="wc__switchlabel">
          <span class="wc__switch" aria-hidden="true"></span>
          <span class="wc__switchtext"><b>Hot weather</b><span>Water needs can double: × 2 for people</span></span>
        </label>
      </div>

      <!-- Pets -->
      <fieldset class="wc__field wc__pets">
        <legend class="wc__label">Pets: total weight</legend>
        <div class="wc__seg" role="radiogroup" aria-label="Weight unit">
          <label><input type="radio" name="unit" value="kg" checked /><span>kg</span></label>
          <label><input type="radio" name="unit" value="lb" /><span>lb</span></label>
        </div>
        <div class="wc__petrow">
          <label for="c1p8-dogs">All dogs</label>
          <input class="wc__num wc__num--sm" id="c1p8-dogs" name="dogs" type="number" inputmode="decimal" min="0" max="2000" step="any" value="0" />
          <span class="wc__unittext" data-unit>kg</span>
        </div>
        <div class="wc__petrow">
          <label for="c1p8-cats">All cats</label>
          <input class="wc__num wc__num--sm" id="c1p8-cats" name="cats" type="number" inputmode="decimal" min="0" max="2000" step="any" value="0" />
          <span class="wc__unittext" data-unit>kg</span>
        </div>
      </fieldset>
    </form>

    <!-- Result -->
    <div class="wc__result" data-result>
      <p class="wc__kicker wc__kicker--ink">You need to store</p>
      <div class="wc__totals" data-totals aria-hidden="true">
        <p><span class="wc__big" data-out="gal">56</span><span class="wc__bigunit">gal</span></p>
        <p><span class="wc__eq">=</span><span class="wc__big" data-out="l">212</span><span class="wc__bigunit">L</span></p>
      </div>
      <p class="wc__perday" aria-hidden="true">Per day: <b data-out="perday">4 gal (15 L)</b></p>
      <ul class="wc__tiles" role="list" aria-hidden="true">
        <li>
          <svg viewBox="0 0 40 48" width="34" height="41" focusable="false"><path d="M13 4 H27 V10 Q35 12 35 20 V42 Q35 45 32 45 H8 Q5 45 5 42 V20 Q5 12 13 10 Z" fill="var(--part-1-tint)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round"/><path d="M6.5 24 H33.5 V42 Q33.5 43.5 32 43.5 H8 Q6.5 43.5 6.5 42 Z" fill="var(--part-1)"/></svg>
          <span><b class="wc__tilenum" data-out="jugs">12</b> <span data-out="jugword">jugs</span> <small>of 5 gal (19 L)</small></span>
        </li>
        <li>
          <svg viewBox="0 0 40 48" width="34" height="41" focusable="false"><rect x="5" y="4" width="30" height="41" rx="4" fill="var(--part-1-tint)" stroke="var(--ink)" stroke-width="3"/><path d="M5 17 H35 M5 32 H35" stroke="var(--ink)" stroke-width="3"/><rect x="11" y="7" width="7" height="4" rx="1" fill="var(--ink)"/></svg>
          <span><b class="wc__tilenum" data-out="drums">2</b> <span data-out="drumword">drums</span> <small>of 55 gal (208 L)</small></span>
        </li>
      </ul>
      <div class="wc__jugrow" data-jugrow aria-hidden="true"></div>
      <p class="wc__split" data-out="split" aria-hidden="true"></p>
      <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-say></p>
    </div>
  </div>

  <ul class="wc__notes" role="list">
    <li>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path d="M9 2 H15 V5 Q19 7 19 11 V20 Q19 22 17 22 H7 Q5 22 5 20 V11 Q5 7 9 5 Z" fill="var(--part-1-tint)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/><path d="M8 14 L11 17 L16 11" fill="none" stroke="var(--ok)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span><b>Bottled water:</b> keep it sealed.</span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2" fill="var(--card)" stroke="var(--ink)" stroke-width="2"/><path d="M3 10 H21 M8 3 V7 M16 3 V7" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"/><text x="12" y="19" text-anchor="middle" font-size="8" font-weight="700" fill="var(--ink)" font-family="var(--font-body)">6</text></svg>
      <span><b>Water you bottle yourself:</b> replace it every 6 months.</span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path d="M12 3 L22 20 H2 Z" fill="var(--warn)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/><path d="M12 9 V14" stroke="var(--warn-ink)" stroke-width="2.5" stroke-linecap="round"/><circle cx="12" cy="17" r="1.3" fill="var(--warn-ink)"/></svg>
      <span><b>Store more</b> for pregnant, sick or nursing people.</span>
    </li>
  </ul>

  <details class="wc__quick" data-quick open>
    <summary>Quick table <span>1 gal (3.8 L) per person per day</span></summary>
    <div class="wc__tablewrap">
      <table>
        <caption class="visually-hidden">Water to store: gallons (litres) for 1 to 6 people for 3, 14 and 30 days</caption>
        <thead>
          <tr><th scope="col">People</th>{DAYS.map((d) => <th scope="col">{d} days</th>)}</tr>
        </thead>
        <tbody>
          {PEOPLE.map((p) => (
            <tr>
              <th scope="row">{p}</th>
              {DAYS.map((d) => (
                <td><b>{p * d} gal</b><span>{litres(p * d)} L</span></td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="wc__tablenote">Hot weather: double it. Add water for pets.</p>
  </details>
</section>

<script>
  const GAL_L = 3.785;
  const DOG_ML = 73; // mL per kg per day (upper end of 63–73)
  const CAT_ML = 60; // mL per kg per day (upper end of 50–60)
  const LB_KG = 0.45359237;
  const KEY = 'og30:water-calc';
  const JUG_MAX = 30;

  const fmt = (n: number) => (n >= 10 ? Math.round(n).toLocaleString('en-US') : String(Math.round(n * 10) / 10));
  // Totals: one decimal below 100 so small pet amounts still show (e.g. 61.4 gal).
  const fmtTotal = (n: number) => (n >= 100 ? Math.round(n).toLocaleString('en-US') : String(Math.round(n * 10) / 10));
  const plural = (n: number, one: string, many: string) => `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;
  const num = (v: string, min: number, max: number, fallback: number) => {
    const n = parseFloat(v);
    return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;
  };

  document.querySelectorAll<HTMLElement>('[data-water-calc]').forEach((root) => {
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const people = form.querySelector<HTMLInputElement>('[name=people]')!;
    const customBox = form.querySelector<HTMLElement>('[data-custom]')!;
    const customDays = form.querySelector<HTMLInputElement>('[name=customDays]')!;
    const hot = form.querySelector<HTMLInputElement>('[name=hot]')!;
    const dogs = form.querySelector<HTMLInputElement>('[name=dogs]')!;
    const cats = form.querySelector<HTMLInputElement>('[name=cats]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const jugrow = root.querySelector<HTMLElement>('[data-jugrow]')!;
    const say = root.querySelector<HTMLElement>('[data-say]')!;
    const totalsEl = root.querySelector<HTMLElement>('[data-totals]')!;
    const quick = root.querySelector<HTMLDetailsElement>('[data-quick]');

    const daysRadio = () => form.querySelector<HTMLInputElement>('[name=days]:checked')!;
    const unit = () => (form.querySelector<HTMLInputElement>('[name=unit]:checked')?.value === 'lb' ? 'lb' : 'kg');

    // Restore last inputs (this device only).
    try {
      const s = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (s && typeof s === 'object') {
        if (s.people) people.value = String(num(s.people, 1, 99, 4));
        if (s.days) {
          const r = form.querySelector<HTMLInputElement>(`[name=days][value="${s.days}"]`);
          if (r) r.checked = true;
        }
        if (s.customDays) customDays.value = String(num(s.customDays, 1, 3650, 60));
        hot.checked = !!s.hot;
        if (s.unit === 'lb') form.querySelector<HTMLInputElement>('[name=unit][value=lb]')!.checked = true;
        if (s.dogs) dogs.value = String(num(s.dogs, 0, 2000, 0));
        if (s.cats) cats.value = String(num(s.cats, 0, 2000, 0));
      }
    } catch {}

    let lastUnit = unit();

    const update = (save = true) => {
      const p = Math.round(num(people.value, 1, 99, 1));
      const custom = daysRadio().value === 'custom';
      customBox.hidden = !custom;
      const d = Math.round(custom ? num(customDays.value, 1, 3650, 1) : Number(daysRadio().value));
      const u = unit();
      root.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => (el.textContent = u));
      const toKg = u === 'lb' ? LB_KG : 1;
      const dogKg = num(dogs.value, 0, 2000, 0) * toKg;
      const catKg = num(cats.value, 0, 2000, 0) * toKg;

      const peopleGal = p * d * (hot.checked ? 2 : 1);
      const petL = ((dogKg * DOG_ML + catKg * CAT_ML) / 1000) * d;
      const totalL = peopleGal * GAL_L + petL;
      const totalGal = totalL / GAL_L;
      const gal1 = Math.round(totalGal * 10) / 10;
      const jugs = Math.ceil(gal1 / 5 - 1e-9);
      const drums = Math.ceil(gal1 / 55 - 1e-9);

      out('gal').textContent = fmtTotal(totalGal);
      out('l').textContent = Math.round(totalL).toLocaleString('en-US');
      totalsEl.classList.toggle('wc__totals--long', (out('gal').textContent! + out('l').textContent!).length > 8);
      out('perday').textContent = `${fmt(totalGal / d)} gal (${fmt(totalL / d)} L)`;
      out('jugs').textContent = jugs.toLocaleString('en-US');
      out('drums').textContent = drums.toLocaleString('en-US');
      out('jugword').textContent = jugs === 1 ? 'jug' : 'jugs';
      out('drumword').textContent = drums === 1 ? 'drum' : 'drums';
      out('split').textContent = petL > 0
        ? `People ${fmt(peopleGal)} gal + pets ${fmt(petL / GAL_L)} gal`
        : `${p} ${p === 1 ? 'person' : 'people'} × ${d} ${d === 1 ? 'day' : 'days'} × ${hot.checked ? '2 gal (hot)' : '1 gal'}`;

      const shown = Math.min(jugs, JUG_MAX);
      jugrow.innerHTML = '<i></i>'.repeat(shown) + (jugs > JUG_MAX ? `<b>+${(jugs - JUG_MAX).toLocaleString('en-US')}</b>` : '');

      say.textContent = `Store ${fmtTotal(totalGal)} gallons, which is ${Math.round(totalL).toLocaleString('en-US')} litres: ${plural(jugs, 'jug', 'jugs')} of 5 gallons or ${plural(drums, 'drum', 'drums')} of 55 gallons.`;

      if (save) {
        try {
          localStorage.setItem(KEY, JSON.stringify({
            people: p, days: daysRadio().value, customDays: customDays.value, hot: hot.checked,
            unit: u, dogs: dogs.value, cats: cats.value,
          }));
        } catch {}
      }
    };

    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const next = Math.round(num(people.value, 1, 99, 1)) + Number(btn.dataset.step);
        people.value = String(Math.min(99, Math.max(1, next)));
        update();
      }),
    );
    form.addEventListener('input', () => update());
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'unit') {
        // Keep the same real weight when the unit changes.
        const u = unit();
        if (u !== lastUnit) {
          const f = u === 'lb' ? 1 / LB_KG : LB_KG;
          [dogs, cats].forEach((el) => {
            const v = parseFloat(el.value);
            if (Number.isFinite(v) && v > 0) el.value = String(Math.round(v * f * 10) / 10);
          });
          lastUnit = u;
        }
      }
      if (t.name === 'people') people.value = String(Math.round(num(people.value, 1, 99, 1)));
      if (t.name === 'days' && t.value === 'custom') customDays.focus();
      update();
    });
    form.addEventListener('submit', (e) => e.preventDefault());

    live.hidden = false;
    // Fold the quick table on screen (the calculator replaces it); always open it for printing.
    if (quick) {
      quick.open = false;
      let wasOpen = false;
      addEventListener('beforeprint', () => { wasOpen = quick.open; quick.open = true; });
      addEventListener('afterprint', () => { quick.open = wasOpen; });
    }
    update(false);
  });
</script>

<style>
  .wc {
    background: var(--card);
    border: 2.5px solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--ink);
  }
  .wc__head {
    display: flex; align-items: center; gap: .75rem;
    padding: .85rem 1rem;
    background: var(--accent-tint);
    border-bottom: 2.5px solid var(--ink);
  }
  .wc__headicon { flex: none; }
  .wc__kicker {
    font-family: var(--font-head); font-weight: 700; font-size: 1rem;
    letter-spacing: .12em; text-transform: uppercase; color: var(--accent-ink);
  }
  .wc__kicker--ink { color: var(--ink); }
  .wc__title { font-size: 1.75rem; line-height: 1.05; }

  /* ---------- Form ---------- */
  .wc__form { display: grid; gap: 1.25rem; padding: 1rem; }
  .wc__field { border: 0; padding: 0; min-width: 0; display: grid; gap: .5rem; }
  .wc__label {
    padding: 0;
    font-family: var(--font-head); font-weight: 700; font-size: 1.375rem;
    letter-spacing: .02em;
  }
  .wc__stepper { display: grid; grid-template-columns: 56px minmax(0, 1fr) 56px; gap: .5rem; max-width: 20rem; }
  .wc__stepbtn {
    display: grid; place-items: center; width: 56px; height: 56px;
    border: 2.5px solid var(--ink); border-radius: 14px;
    background: var(--card); color: var(--ink);
  }
  .wc__stepbtn:hover { background: var(--card-2); }
  .wc__stepbtn:active { background: var(--accent-tint); }
  .wc__num {
    width: 100%; height: 56px; min-width: 0;
    border: 2.5px solid var(--ink); border-radius: 14px;
    background: var(--card); color: var(--ink);
    font-family: var(--font-head); font-weight: 700; font-size: 2rem; text-align: center;
    -moz-appearance: textfield; appearance: textfield;
  }
  .wc__num::-webkit-outer-spin-button, .wc__num::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .wc__num--sm { width: 6.5rem; height: 52px; font-size: 1.5rem; }

  .wc__chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .wc__chip, .wc__seg label { position: relative; cursor: pointer; }
  .wc__chip input, .wc__seg input, .wc__switchinput {
    position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none;
  }
  .wc__chip span {
    display: inline-flex; align-items: center; justify-content: center; gap: .3rem;
    min-width: 64px; min-height: 52px; padding: 0 1rem;
    border: 2.5px solid var(--rule-strong); border-radius: 999px;
    background: var(--card); font-weight: 700; font-size: 1.25rem;
  }
  .wc__chip:hover span { border-color: var(--ink); }
  .wc__chip input:checked + span { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .wc__chip input:checked + span::before { content: '✓'; font-size: 1rem; }
  .wc__chip input:focus-visible + span,
  .wc__seg input:focus-visible + span,
  .wc__switchinput:focus-visible + .wc__switchlabel .wc__switch { outline: 3px solid var(--focus); outline-offset: 3px; }
  .wc__custom { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; font-weight: 700; }
  .wc__custom[hidden] { display: none; }
  .wc__hint { font-size: 1rem; color: var(--ink-2); }

  .wc__switchlabel { display: flex; align-items: center; gap: .85rem; min-height: 56px; cursor: pointer; }
  .wc__switch {
    position: relative; flex: none; width: 76px; height: 42px;
    border: 2.5px solid var(--ink); border-radius: 999px; background: var(--card-2);
  }
  .wc__switch::before {
    content: 'OFF'; position: absolute; right: 9px; top: 50%; transform: translateY(-50%);
    font-family: var(--font-head); font-weight: 700; font-size: .95rem; letter-spacing: .04em; color: var(--ink-2);
  }
  .wc__switch::after {
    content: ''; position: absolute; left: 4px; top: 4px; width: 29px; height: 29px;
    border-radius: 50%; background: var(--card); border: 2.5px solid var(--ink);
    transition: transform .15s;
  }
  .wc__switchinput:checked + .wc__switchlabel .wc__switch { background: var(--part-4); }
  .wc__switchinput:checked + .wc__switchlabel .wc__switch::before { content: 'ON'; right: auto; left: 10px; color: var(--on-part-4); }
  .wc__switchinput:checked + .wc__switchlabel .wc__switch::after { transform: translateX(34px); }
  .wc__switchtext { display: grid; line-height: 1.25; }
  .wc__switchtext b { font-size: 1.25rem; }
  .wc__switchtext span { font-size: 1rem; color: var(--ink-2); }

  .wc__pets { gap: .6rem; }
  .wc__seg { display: inline-flex; justify-self: start; border: 2.5px solid var(--ink); border-radius: 999px; overflow: hidden; }
  .wc__seg span { display: grid; place-items: center; min-width: 64px; min-height: 48px; font-weight: 700; font-size: 1.125rem; }
  .wc__seg label + label span { border-left: 2.5px solid var(--ink); }
  .wc__seg input:checked + span { background: var(--ink); color: var(--paper); }
  .wc__petrow { display: grid; grid-template-columns: 5.5rem auto 1fr; align-items: center; gap: .6rem; font-weight: 700; }
  .wc__unittext { color: var(--ink-2); }

  /* ---------- Result ---------- */
  .wc__result {
    padding: 1rem;
    background: var(--accent-tint);
    border-top: 2.5px solid var(--ink);
    border-bottom: 2.5px solid var(--ink);
  }
  .wc__totals { display: flex; align-items: baseline; flex-wrap: wrap; column-gap: .6rem; margin: .1rem 0 .25rem; }
  .wc__big {
    font-family: var(--font-head); font-weight: 700; font-size: clamp(3.25rem, 15vw, 4.5rem); line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .wc__bigunit { font-family: var(--font-head); font-weight: 700; font-size: 1.75rem; margin-left: .2rem; }
  .wc__eq { font-family: var(--font-head); font-size: 2rem; font-weight: 700; color: var(--ink-2); margin-right: .5rem; }
  .wc__totals--long .wc__big { font-size: 2.5rem; }
  .wc__totals--long .wc__bigunit { font-size: 1.375rem; }
  .wc__perday { font-size: 1.125rem; }
  .wc__tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: .6rem; margin-top: .85rem; }
  .wc__tiles li {
    display: flex; align-items: center; gap: .6rem; max-width: none;
    padding: .6rem .75rem; background: var(--card);
    border: 2px solid var(--ink); border-radius: var(--radius-sm);
