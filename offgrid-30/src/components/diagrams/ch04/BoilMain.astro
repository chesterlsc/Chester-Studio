---
// 4.3 main visual: rolling boil + 1-minute timer + altitude rule.
---
<svg class="diagram" viewBox="0 0 520 470" role="img" aria-labelledby="bm-t bm-d">
  <title id="bm-t">How to boil water safely</title>
  <desc id="bm-d">A pot on a fire. Big bubbles rise all over the water: this is a rolling boil. A timer shows 1 minute. A mountain shows that above 1,000 meters or 3,300 feet you boil for 3 minutes.</desc>
  <defs>
    <clipPath id="bm-water"><path d="M64 168 Q96 156 128 168 T192 168 T256 168 T316 166 V296 Q316 306 306 306 H74 Q64 306 64 296 Z"/></clipPath>
  </defs>

  <!-- Steam -->
  <g fill="none" stroke="var(--ink-2)" stroke-width="3" stroke-linecap="round" opacity=".75">
    <path d="M120 120 c-14 -16 14 -26 0 -44 c-10 -12 6 -22 4 -32"/>
    <path d="M190 112 c-14 -16 14 -26 0 -44 c-10 -12 6 -22 4 -32"/>
    <path d="M260 120 c-14 -16 14 -26 0 -44 c-10 -12 6 -22 4 -32"/>
  </g>

  <!-- Pot -->
  <path d="M30 154 h30 M320 154 h30" stroke="var(--ink)" stroke-width="10" stroke-linecap="round"/>
  <path d="M60 140 V292 Q60 314 82 314 H298 Q320 314 320 292 V140" fill="#B9C2CA" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round"/>
  <path d="M50 140 H330" stroke="var(--ink)" stroke-width="6" stroke-linecap="round"/>

  <!-- Water + bubbles -->
  <path d="M64 168 Q96 156 128 168 T192 168 T256 168 T316 166 V296 Q316 306 306 306 H74 Q64 306 64 296 Z" fill="var(--part-1)" fill-opacity=".45"/>
  <g clip-path="url(#bm-water)" fill="#FFFFFF" fill-opacity=".9" stroke="var(--part-1-ink)" stroke-width="2">
    <circle cx="92" cy="286" r="9"/><circle cx="100" cy="246" r="12"/><circle cx="88" cy="204" r="14"/>
    <circle cx="140" cy="276" r="11"/><circle cx="150" cy="226" r="15"/><circle cx="132" cy="186" r="10"/>
    <circle cx="196" cy="288" r="8"/><circle cx="190" cy="252" r="13"/><circle cx="204" cy="200" r="16"/>
    <circle cx="244" cy="270" r="12"/><circle cx="252" cy="224" r="14"/><circle cx="238" cy="184" r="9"/>
    <circle cx="292" cy="284" r="9"/><circle cx="288" cy="242" r="13"/><circle cx="296" cy="196" r="12"/>
  </g>
  <!-- bubbles breaking the surface -->
  <g fill="#FFFFFF" stroke="var(--part-1-ink)" stroke-width="2">
    <path d="M96 166 a12 12 0 0 1 24 0"/><path d="M164 166 a14 14 0 0 1 28 0"/><path d="M226 167 a11 11 0 0 1 22 0"/><path d="M276 166 a13 13 0 0 1 26 0"/>
  </g>

  <!-- Fire -->
  <path d="M70 326 H310" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
  <g stroke="var(--ink)" stroke-width="2" stroke-linejoin="round">
    <path d="M110 372 c-18 0 -22 -22 -10 -34 c2 8 6 10 10 10 c-4 -14 4 -22 12 -26 c-2 12 12 18 12 32 c0 12 -10 18 -24 18z" fill="var(--part-3)"/>
    <path d="M175 376 c-22 0 -26 -26 -12 -40 c2 10 8 12 12 12 c-4 -16 4 -26 14 -30 c-2 14 14 20 14 38 c0 14 -12 20 -28 20z" fill="var(--part-4)"/>
    <path d="M240 376 c-22 0 -26 -26 -12 -40 c2 10 8 12 12 12 c-4 -16 4 -26 14 -30 c-2 14 14 20 14 38 c0 14 -12 20 -28 20z" fill="var(--part-3)"/>
    <path d="M296 372 c-18 0 -22 -22 -10 -34 c2 8 6 10 10 10 c-4 -14 4 -22 12 -26 c-2 12 12 18 12 32 c0 12 -10 18 -24 18z" fill="var(--part-4)"/>
  </g>
  <path d="M86 384 l200 0" stroke="var(--ink)" stroke-width="7" stroke-linecap="round"/>

  <!-- Step markers -->
  <g font-family="var(--font-head)" font-weight="700" font-size="20" text-anchor="middle">
    <circle cx="40" cy="226" r="17" fill="var(--accent)"/><text x="40" y="233" fill="var(--on-accent)">3</text>
    <circle cx="372" cy="40" r="17" fill="var(--accent)"/><text x="372" y="47" fill="var(--on-accent)">4</text>
  </g>

  <!-- Label: rolling boil -->
  <g font-family="var(--font-body)" fill="var(--ink)">
    <path d="M306 218 L360 218" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="306" cy="218" r="4" fill="var(--ink)"/>
    <text x="366" y="210" font-size="19" font-weight="700">Rolling boil</text>
    <text x="366" y="232" font-size="16">Big bubbles rise</text>
    <text x="366" y="251" font-size="16">all over, non-stop</text>
  </g>

  <!-- Timer -->
  <g transform="translate(442 84)">
    <circle r="50" fill="var(--card)" stroke="var(--ink)" stroke-width="4"/>
    <path d="M-10 -62 h20 M0 -62 v12" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
    <path d="M0 0 L0 -50 A50 50 0 1 1 -0.01 -50 Z" fill="var(--accent)" fill-opacity=".22"/>
    <text y="10" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="34" fill="var(--ink)">1 MIN</text>
    <text y="34" text-anchor="middle" font-family="var(--font-body)" font-weight="700" font-size="15" fill="var(--ink)">at least</text>
  </g>
  <text x="442" y="160" text-anchor="middle" font-family="var(--font-body)" font-size="16" font-weight="700" fill="var(--ink)">Keep it rolling</text>

  <!-- Altitude inset -->
  <g transform="translate(340 300)">
    <rect x="0" y="0" width="176" height="166" rx="12" fill="var(--card)" stroke="var(--ink)" stroke-width="2.5"/>
    <text x="12" y="25" font-family="var(--font-body)" font-size="15" font-weight="700" fill="var(--ink)">Above 1,000 m</text>
    <text x="12" y="44" font-family="var(--font-body)" font-size="15" fill="var(--ink)">(3,300 ft)</text>
    <path d="M14 152 L58 64 L84 104 L102 84 L162 152 Z" fill="var(--part-8-tint)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <path d="M47 86 L58 64 L69 86 Z" fill="var(--card)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/>
    <path d="M8 112 H168" stroke="var(--ink)" stroke-width="2.5" stroke-dasharray="7 5"/>
    <rect x="98" y="118" width="70" height="34" rx="8" fill="var(--ink)"/>
    <text x="133" y="142" text-anchor="middle" font-family="var(--font-head)" font-weight="700" font-size="22" fill="var(--paper)">3 MIN</text>
  </g>
</svg>
