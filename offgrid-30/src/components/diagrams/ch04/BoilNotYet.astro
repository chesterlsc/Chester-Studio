  <path d="M40 60 V172 Q40 188 56 188 H264 Q280 188 280 172 V60" fill="#B9C2CA" stroke="var(--ink)" stroke-width="3"/>
  <path d="M32 60 H288" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/>
  <path d="M44 84 H276 V170 Q276 184 262 184 H58 Q44 184 44 170Z" fill="var(--part-1)" fill-opacity=".38"/>
  <g fill="#fff" stroke="var(--part-1-ink)" stroke-width="1.5">
