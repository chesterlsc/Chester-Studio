---
import { ICONS, type IconName } from './paths';
interface Props { name: IconName; size?: number; label?: string; class?: string; }
const { name, size = 24, label, class: cls } = Astro.props;
const body = ICONS[name];
if (!body) throw new Error(`Unknown icon: ${name}`);
---
<svg
  class:list={['icon', cls]}
  width={size} height={size} viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
<style is:global>
  .icon { flex: none; overflow: visible; }
  .icon .f { fill: currentColor; stroke: none; }
</style>
