---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/icons/Icon.astro';
import { chapters, pageHref } from '../../../lib/toc';
import { SECTIONS, PARTS, type SectionKey } from '../../../data/sections';
import { availableIds } from '../../../lib/available';
export function getStaticPaths() {
  return chapters.map((ch) => ({ params: { chapter: ch.slug }, props: { ch } }));
}
const { ch } = Astro.props;
const sec = SECTIONS[ch.section as SectionKey];
const ready = await availableIds();
---
<Base title={`Ch ${ch.n}: ${ch.title}`} part={ch.part}>
  <div class="wrap" data-part={ch.part}>
    <p class="band"><Icon name={sec.icon as any} /> Part {ch.part} · {PARTS[ch.part].name} / {sec.title}</p>
    <h1><span>Chapter {ch.n}</span>{ch.title}</h1>
    <ol class="grid" role="list">
      {ch.pages.map((p) => (
        <li>
          {ready.has(p.id)
            ? <a class="pg card" href={pageHref(p.id)}><span class="pg__id">{p.id}</span><b>{p.title}</b>{p.has3d && <span class="pg__3d"><Icon name="cube" size={18} /> 3D</span>}</a>
            : <div class="pg card pg--todo"><span class="pg__id">{p.id}</span><b>{p.title}</b><small>Coming soon</small>{p.has3d && <span class="pg__3d"><Icon name="cube" size={18} /> 3D</span>}</div>}
        </li>
      ))}
    </ol>
  </div>
</Base>
<style>
  .wrap { max-width: 1100px; margin: 0 auto; padding: var(--s4) var(--gutter); }
  .band { display: inline-flex; gap: .5rem; align-items: center; padding: .4rem .9rem; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-family: var(--font-head); font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
  h1 { margin: var(--s2) 0 var(--s4); }
  h1 span { display: block; font-size: 1.1rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-ink); }
  .grid { display: grid; gap: var(--s2); grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .pg { display: flex; flex-direction: column; gap: .35rem; height: 100%; padding: var(--s2); color: var(--ink); text-decoration: none; border-top: 6px solid var(--accent); }
  a.pg:hover { border-color: var(--ink); }
  .pg__id { font-family: var(--font-mono); color: var(--accent-ink); }
  .pg--todo { opacity: .7; border-top-style: dashed; }
  .pg small { color: var(--ink-2); }
  .pg__3d { margin-top: auto; display: inline-flex; gap: .3rem; align-items: center; font-weight: 700; font-size: .95rem; color: var(--accent-ink); }
</style>
