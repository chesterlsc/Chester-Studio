---
import Base from '../layouts/Base.astro';
import Icon from '../components/icons/Icon.astro';
import { parts, chapters } from '../lib/toc';
import { SECTIONS, type SectionKey } from '../data/sections';
import { url } from '../lib/url';
---
<Base title="OFFGRID 30">
  <section class="hero">
    <div class="hero__inner">
      <p class="kicker">The survival book for the long run</p>
      <h1>OFFGRID <span>30</span></h1>
      <p class="hero__lede">How to live <b>30 years without power</b>. Water, food, shelter, health, family and community, shown in pictures, step by step.</p>
      <p class="hero__meta">For ages 10 to 80 · {chapters.length} chapters · {chapters.length * 10} pages · Works offline</p>
      <div class="hero__cta">
        <a class="btn btn--solid" href={url('/c/04-making-water-safe/03-boiling-the-gold-standard/')}><Icon name="book" /> See a sample page</a>
        <a class="btn" href={url('/contents/')}><Icon name="search" /> Contents</a>
        <a class="btn" href={url('/design/')}><Icon name="legend" /> Design system</a>
      </div>
    </div>
  </section>

  <section class="parts" aria-label="The 8 parts of the book">
    {parts.map((p) => (
      <a class="part card" data-part={p.n} href={url(`/contents/#part-${p.n}`)}>
        <span class="part__band"><b>Part {p.n}</b><span>{p.title}</span></span>
        <ul role="list">
          {p.sections.map((s) => (
            <li><Icon name={SECTIONS[s.key as SectionKey].icon as any} size={22} /> {s.title}</li>
          ))}
        </ul>
      </a>
    ))}
  </section>
</Base>
<style>
  .hero { padding: var(--s5) var(--gutter) var(--s4); background: var(--card-2); border-bottom: 1px solid var(--rule); }
  .hero__inner { max-width: 1100px; margin: 0 auto; }
  .hero h1 { font-size: clamp(3.5rem, 13vw, 7.5rem); letter-spacing: .03em; line-height: .9; margin: .3rem 0 var(--s2); }
  .hero h1 span { color: var(--part-4-ink); }
  .hero__lede { font-size: calc(var(--fs-body) * 1.25); max-width: 34ch; }
  .hero__meta { margin-top: var(--s2); color: var(--ink-2); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: var(--s3); }
  .parts { max-width: 1100px; margin: var(--s4) auto; padding: 0 var(--gutter); display: grid; gap: var(--s2); grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .part { overflow: hidden; color: var(--ink); text-decoration: none; }
  .part:hover { border-color: var(--ink); }
  .part__band { display: flex; flex-direction: column; padding: .8rem 1rem; background: var(--accent); color: var(--on-accent); font-family: var(--font-head); text-transform: uppercase; letter-spacing: .06em; }
  .part__band b { font-size: .95rem; opacity: .85; }
  .part__band span { font-size: 1.6rem; font-weight: 700; line-height: 1.05; }
  .part ul { padding: .75rem 1rem 1rem; display: grid; gap: .35rem; }
  .part li { display: flex; align-items: center; gap: .5rem; font-size: 1.05rem; }
  .part li :global(.icon) { color: var(--accent-ink); }
</style>
