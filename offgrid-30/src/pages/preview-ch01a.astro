---
import Base from '../layouts/Base.astro';
import BodyWater from '../components/diagrams/ch01/BodyWater.astro';
import DailyGallon from '../components/diagrams/ch01/DailyGallon.astro';
import DehydrationSigns from '../components/diagrams/ch01/DehydrationSigns.astro';
import PeeChart from '../components/diagrams/ch01/PeeChart.astro';
import ExtraWater from '../components/diagrams/ch01/ExtraWater.astro';
---
<Base title="preview" part={1}>
  <div data-part="1" style="max-width:560px;margin:auto;display:grid;gap:24px">
    <div id="d1"><BodyWater /></div>
    <div id="d2"><DailyGallon /></div>
    <div id="d3"><DehydrationSigns /></div>
    <div id="d4"><PeeChart /></div>
    <div id="d5"><ExtraWater /></div>
  </div>
</Base>
<style is:global>svg.diagram{width:100%;height:auto;display:block}</style>
