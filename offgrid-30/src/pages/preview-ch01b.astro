---
import Base from '../layouts/Base.astro';
import AnimalWater from '../components/diagrams/ch01/AnimalWater.astro';
import HiddenWater from '../components/diagrams/ch01/HiddenWater.astro';
import MainValve from '../components/diagrams/ch01/MainValve.astro';
import LowWaterPlan from '../components/diagrams/ch01/LowWaterPlan.astro';
import WaterCalc from '../components/diagrams/ch01/WaterCalc.astro';
---
<Base title="preview" part={1}>
  <div data-part="1" style="max-width:560px;margin:auto;display:grid;gap:24px">
    <div id="d-animal" style="background:var(--accent-tint);border-radius:8px"><AnimalWater /></div>
    <div id="d-hidden" style="background:var(--accent-tint);border-radius:8px"><HiddenWater /></div>
    <div id="d-valve" style="background:var(--accent-tint);border-radius:8px"><MainValve /></div>
    <div id="d-low" style="background:var(--accent-tint);border-radius:8px"><LowWaterPlan /></div>
    <div id="d-calc"><WaterCalc /></div>
  </div>
</Base>
